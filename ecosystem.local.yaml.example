# ecosystem.local.yaml — Per-developer overrides (gitignored)
#
# Copy this file to ecosystem.local.yaml and fill in your details.
# This file is deep-merged on top of the overlay and upstream configs.
#
# Setup:
#   cp ecosystem.local.yaml.example ecosystem.local.yaml
#   # Edit the identity section below

# Template overlay URL — used by `ws overlay init` to clone tutorial content.
# Your community overlay may override this.
defaults:
  templateOverlay: https://github.com/SiliconSaga/overlay-yggdrasil-template.git

# Your identity — used for commit attribution, PR/issue templates, and push.
# human_account is personal and should NOT be in shared overlay configs.
# forkOrg is the org/group name used as the default git remote for push/issue.
# co_authored_by is typically set by the overlay; override here if needed.
identity:
  human_account: your-github-username
  forkOrg: your-org-name               # matches your git remote name
  # co_authored_by: "Claude Opus 4.6"   # override overlay default

# Git provider detection — usually auto-detected from remote URLs.
# Uncomment under the existing defaults: block above for self-hosted instances.
#   gitProvider: github            # workspace-wide default
#   gitProviders:                  # domain → provider mapping
#     git.mycompany.com: gitlab
#
# Default upstream remote for `ws cr --upstream` when a repo has multiple remotes.
# Usually set in your overlay; override here to temporarily target a different remote.
#   upstreamRemote: myorg

# Overlay selector — uncomment to override auto-detection.
# overlay: overlay-yggdrasil-live

# Component overrides — uncomment and modify as needed.
# components:
#   echo-test:
#     disabled: false         # Enable to test chart resolution
#   some-component:
#     forceChart: true        # Use chart even with local source
#     values:
#       key: local-value
