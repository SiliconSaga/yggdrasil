# ecosystem.local.yaml — Per-developer overrides (gitignored)
#
# Copy this file to ecosystem.local.yaml and fill in your details.
# This file is deep-merged on top of the realm and upstream configs.
#
# Setup:
#   cp ecosystem.local.yaml.example ecosystem.local.yaml
#   # Edit the identity section below

# Template realm URL — used by `ws realm init` to clone tutorial content.
# Your community realm may override this.
defaults:
  templateRealm: https://github.com/SiliconSaga/realm-template.git

# Your identity — used for commit attribution, PR/issue templates, and push.
# human_account is personal and should NOT be in shared realm configs.
# forkOrg is the org/group name used as the default git remote for push/issue.
# co_authored_by is typically set by the realm; override here if needed.
identity:
  human_account: your-github-username
  forkOrg: your-org-name               # matches your git remote name
  # co_authored_by: "Claude Opus 4.6"   # override realm default

# Git provider detection — usually auto-detected from remote URLs.
# Uncomment under the existing defaults: block above for self-hosted instances.
#   gitProvider: github            # workspace-wide default
#   gitProviders:                  # domain → provider mapping
#     git.mycompany.com: gitlab
#
# Default upstream remote for `ws cr --upstream` when a repo has multiple remotes.
# Usually set in your realm; override here to temporarily target a different remote.
#   upstreamRemote: myorg
#
# Fork transport for `ws clone-fork` (https | ssh; default https). https injects
# your .env token per-process (no SSH keys, no credential-manager prompt) and
# auto-falls-back to ssh when no token covers the host.
#   forkTransport: ssh

# Realm selector — uncomment to override auto-detection.
# realm: realm-siliconsaga

# Component overrides — uncomment and modify as needed.
# components:
#   some-component:
#     disabled: true          # Skip this component on `ws clone --all`
#     repo: <git-url>         # Override the declared repo URL
