# Environment and drafts
.env
.issues/
.crs/
.commits/
.outputs/
.DS_Store

# Nested Git repos — cloned by ws-clone.sh, ignored by yggdrasil's Git.
# Only .gitkeep is tracked so the directory structure is preserved.
/components/*
!/components/.gitkeep

# Realm repos — cloned by ws realm, ignored by yggdrasil's Git.
/realms/*
!/realms/.gitkeep

# Hoard repos — personal containers cloned by ws hoard, ignored by yggdrasil's Git.
/hoards/*
!/hoards/.gitkeep

# Local ecosystem overrides (per-developer, never committed)
ecosystem.local.yaml

# Generated ArgoCD manifests from ws-resolve.sh
/.generated/

# Workspace-local scratch / temp area — synthetic git repos used by
# manual command testing and ad-hoc validation. Use this instead of
# /tmp on Windows where Git Bash maps it to an unpredictable location.
/.tmp/

# External / fetched templates (future marketplace) — gitignored payloads,
# only the .gitkeep is tracked.
/templates/external/*
!/templates/external/.gitkeep

# Claude Code local settings — per-user overrides, never committed
.claude/settings.local.json

# Claude Code runtime state — scheduled-task lock file, recreated on demand
.claude/scheduled_tasks.lock

# Project-level safe-bash-extras for the PreToolUse hook — personal
# per-machine config, not project policy. The `.example` template
# IS tracked; the live file is opt-in and stays local.
.claude/hooks/safe-bash-extras

# Claude Code MCP server config — generated per-user by ws mcp-setup, never committed
# (content is realm-specific; regenerate with: bash scripts/ws mcp-setup)
/.mcp.json

# IDE workspace files — generated per-user via ws-vscode.sh, not shared
*.code-workspace

# Thalamus — shared human-AI thinking space (local, never committed)
# Root-only to avoid matching docs/gdd/thalamus.md or nested paths.
# Note: ThalamusNoGit.md is intentionally NOT gitignored — it exists as an
# escape hatch for tooling that refuses to write to gitignored files.
/Thalamus.md
