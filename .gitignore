# Environment and drafts
.env
.issues/
.crs/
.commits/
.DS_Store

# Nested Git repos — cloned by ws-clone.sh, ignored by yggdrasil's Git.
# Only .gitkeep is tracked so the directory structure is preserved.
/components/*
!/components/.gitkeep

# Overlay repos — cloned by ws overlay, ignored by yggdrasil's Git.
/overlays/*
!/overlays/.gitkeep

# Local ecosystem overrides (per-developer, never committed)
ecosystem.local.yaml

# Generated ArgoCD manifests from ws-resolve.sh
/.generated/

# Claude Code local settings — per-user overrides, never committed
.claude/settings.local.json

# Claude Code MCP server config — generated per-user by ws mcp-setup, never committed
# (content is overlay-specific; regenerate with: bash scripts/ws mcp-setup)
/.mcp.json

# IDE workspace files — generated per-user via ws-vscode.sh, not shared
*.code-workspace

# Thalamus — shared human-AI thinking space (local, never committed)
# Root-only to avoid matching docs/gdd/thalamus.md or nested paths.
# Note: ThalamusNoGit.md is intentionally NOT gitignored — it exists as an
# escape hatch for tooling that refuses to write to gitignored files.
/Thalamus.md
