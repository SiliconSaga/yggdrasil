#!/usr/bin/env bash
# ws — Unified workspace CLI for yggdrasil
#
# Usage:
#   ws <command> [args...]
#   ws help
#
# Commands:
#   list              List ecosystem components (tier, repo, clone status)
#   status [--verbose] Git status across workspace
#   clone [comp|--all|--url <url> [--name N] [--add-eco]] Clone components
#   pull [comp]       Pull all or one component
#   resolve           Generate ArgoCD Applications
#   vscode            Generate VS Code workspace file
#   push [comp] [branch] [--force] Push branch (remote from identity.forkOrg)
#   cr <comp> [--upstream] <title> <bodyfile>  Open a CR (change request/PR/MR; --upstream for cross-fork)
#   issue <comp> [remote] <title> <label> <bodyfile> File issue (remote from forkOrg)
#   test <comp> [TestName|args...] Run tests (auto-detected; see 'ws actions <comp>')
#   review <comp> <cr#|threads> [options]  CR review comments and threads (see ws review --help)
#   commit <comp> <bodyfile> Commit with Co-Authored-By trailer (bodyfile-driven; see templates/commit.md)
#   log [comp] [--oneline] Show commits on current branch vs main
#   clean             Remove draft files from .issues/, .crs/, .commits/
#   exec <comp> <cmd...> Run a command in a component dir (max 6 cmd args)
#   realm init        Clone template realm for tutorials
#   realm <url>       Clone a community realm
#   realm use <name>  Set active realm
#   realm list        Show available realms
#   hoard init [template] [--name <name>]   Scaffold a new hoard (default template: thalami)
#   hoard <url>                Clone an existing hoard
#   hoard list                 Show hoards and which thalami hoard is active
#   hoard upgrade <hoard-name> Re-fetch plugins and refresh configs from the template
#   component init <flavor> [name]   Scaffold a new component from a template
#   component list                   Show known component flavors
#   actions <comp>    List adapter commands for a component
#   preflight [--soft]  Check workspace prerequisites (bash, git, yq, jq, gh/glab)
#   audit-permissions [--names-only]  Flag broad permissions.allow patterns across all 3 scopes
#   mcp-setup [--dry-run]  Generate .mcp.json from realm mcp.servers declarations
#   mcp-status        Show currently configured MCP servers
#   help              Show this help message (or `ws help <subcommand>` for per-command help)
#
# Auth commands (run these before ws push / ws cr):
#   gitlab-auth [--status]  Configure glab + git credentials from .env tokens.
#                           --status: show which token env vars are set/unset (no changes made).
#   diagnose <comp>         Show ecosystem entry, clone status, remotes, provider detection,
#                           and which gitToken env var covers each remote (set or missing).
#                           Run this when push/cr fails with auth or remote errors.
#
# First-time setup:
#   1. Add tokens to .env  (see docs/git-provider-setup.md for token scopes)
#   2. source .env
#   3. ws gitlab-auth       (registers glab + git credential helper)
#   4. ws clone <comp>
#   5. ws diagnose <comp>   (verify token coverage before pushing)
#
# For shorthand access, add to your shell profile:
#   export PATH="<yggdrasil>/scripts:$PATH"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
: "${ECOSYSTEM:="$ROOT_DIR/ecosystem.yaml"}"
: "${ECOSYSTEM_LOCAL:="$ROOT_DIR/ecosystem.local.yaml"}"
: "${REALMS_DIR:="$ROOT_DIR/realms"}"
: "${COMPONENTS_DIR:="$ROOT_DIR/components"}"
# Export ECOSYSTEM_LOCAL so non-exported caller-side overrides
# (`ECOSYSTEM_LOCAL=/foo ws ...`) propagate to every child script
# without each one independently re-deriving the path.
export ECOSYSTEM_LOCAL
# Auto-source .env if present — makes tokens available to all sub-commands
# without requiring `source .env` before every ws invocation.
[[ -f "$ROOT_DIR/.env" ]] && source "$ROOT_DIR/.env"

# Source shared functions (ws_validate_component, ws_detect_realm,
# ws_resolve_ecosystem, COMPONENT_DIR, etc.)
# shellcheck source=ws-realm.sh
source "$SCRIPT_DIR/ws-realm.sh"

ws_help() {
    sed -n '/^# Usage:$/,/^$/p' "${BASH_SOURCE[0]}" | grep '^#' | sed 's/^# \?//'
}

# Resolve identity.forkOrg from merged ecosystem config.
# Returns the forkOrg value (e.g. "SiliconSaga") or empty string.
_ws_fork_org="" # cached
ws_resolve_fork_org() {
    if [[ -n "$_ws_fork_org" ]]; then
        echo "$_ws_fork_org"
        return
    fi
    local eco
    eco="$(ws_resolve_ecosystem 2>/dev/null)" || return 0
    _ws_fork_org=$(yq '.identity.forkOrg // ""' "$eco" 2>/dev/null)
    [[ "$_ws_fork_org" == "null" ]] && _ws_fork_org=""
    echo "$_ws_fork_org"
}

ws_exec() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: ws exec <component> <command...>" >&2
        exit 1
    fi
    if [[ $# -gt 7 ]]; then
        echo "ERROR: Too many arguments (max 7: component + 6 command args)." >&2
        echo "  For complex commands, use a Makefile target or shell script." >&2
        exit 1
    fi
    local comp="$1"
    shift
    ws_validate_component "$comp"
    cd "$COMPONENT_DIR" && "$@"
}

ws_push() {
    # Detect --help/-h anywhere in args (e.g. `ws push my-comp --help`),
    # not just $1, so the typical UNIX-y "any position" form works.
    local _arg
    for _arg in "$@"; do
        if [[ "$_arg" == "--help" || "$_arg" == "-h" ]]; then
            cat <<'HELP'
Usage: ws push [component] [branch] [--force]

  component  Component to push (default: yggdrasil)
  branch     Branch to push (default: current branch)
  --force    Force push (use with care; only after a rebase typically)

Pushes to the component's per-developer fork remote (resolved via
identity.forkOrg in ecosystem config). For repos you own directly,
pushes to the configured remote.
HELP
            return 0
        fi
    done
    if [[ $# -gt 3 ]]; then
        echo "Usage: ws push [component] [branch] [--force]" >&2
        exit 1
    fi
    local comp="${1:-yggdrasil}"
    local branch=""
    local force=""
    shift 2>/dev/null || true
    for arg in "$@"; do
        case "$arg" in
            --force) force="--force" ;;
            -*) echo "ERROR: Unknown option '$arg'" >&2; exit 1 ;;
            *) branch="$arg" ;;
        esac
    done
    ws_validate_component "$comp"
    # Pass forkOrg as push remote hint (only if set and not already overridden)
    local fork_org
    fork_org=$(ws_resolve_fork_org)
    if [[ -n "$fork_org" && -z "${GIT_PUSH_REMOTE:-}" ]]; then
        export GIT_PUSH_REMOTE="$fork_org"
    fi
    cd "$COMPONENT_DIR" && bash "$SCRIPT_DIR/git-push.sh" ${force:+"$force"} ${branch:+"$branch"}
}

ws_cr() {
    if [[ $# -lt 3 || $# -gt 4 ]]; then
        echo "Usage: ws cr <component> [--upstream] <title> <bodyfile>" >&2
        exit 1
    fi
    local comp="$1"
    shift
    ws_validate_component "$comp"
    # Resolve bodyfile path before cd (last arg is always the bodyfile)
    local args=("$@")
    local last_idx=$(( ${#args[@]} - 1 ))
    if [[ "${args[$last_idx]}" != /* ]]; then
        args[$last_idx]="$ROOT_DIR/${args[$last_idx]}"
    fi
    cd "$COMPONENT_DIR" && bash "$SCRIPT_DIR/git-cr.sh" "${args[@]}"
}


ws_log() {
    # Detect --help anywhere in args.
    for _arg in "$@"; do
        if [[ "$_arg" == "--help" || "$_arg" == "-h" ]]; then
            cat <<'HELP'
Usage: ws log [component] [--oneline] [--limit N]

Show commits on the current branch that aren't on main.

Options:
  --oneline           One line per commit (default: full log)
  --limit N           Show only the most recent N commits
  --limit=N           Same; equals form also accepted

Examples:
  ws log                       # yggdrasil branch vs main
  ws log --oneline             # compact format
  ws log --limit 5             # last 5 commits, full format
  ws log --oneline --limit=10  # last 10, one-line each (equals form)
  ws log mimir                 # mimir branch vs main
HELP
            return 0
        fi
    done

    local comp=""
    local oneline=""
    local limit=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --oneline) oneline="--oneline"; shift ;;
            --limit)
                [[ $# -ge 2 ]] || { echo "ERROR: --limit requires a value" >&2; exit 1; }
                if ! [[ "$2" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --limit value '$2' must be a non-negative integer" >&2
                    exit 1
                fi
                limit="$2"; shift 2 ;;
            --limit=*)
                limit="${1#--limit=}"
                if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --limit value '$limit' must be a non-negative integer" >&2
                    exit 1
                fi
                shift ;;
            -*)
                echo "ERROR: Unknown option '$1'" >&2
                exit 1 ;;
            *)
                if [[ -n "$comp" ]]; then
                    echo "ERROR: Multiple components specified ('$comp' and '$1')." >&2
                    echo "  Usage: ws log [component] [--oneline] [--limit N]" >&2
                    exit 1
                fi
                comp="$1"; shift ;;
        esac
    done

    if [[ -n "$comp" ]]; then
        ws_validate_component "$comp"
    else
        COMPONENT_DIR="$ROOT_DIR"
    fi

    cd "$COMPONENT_DIR"

    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
        echo "ERROR: Not on a branch (detached HEAD)." >&2
        exit 1
    fi

    # Detect the main branch (main or master)
    local main_branch="main"
    if ! git rev-parse --verify main &>/dev/null; then
        if git rev-parse --verify master &>/dev/null; then
            main_branch="master"
        else
            echo "ERROR: Cannot find main or master branch." >&2
            exit 1
        fi
    fi

    if [[ "$branch" == "$main_branch" ]]; then
        echo "(on $main_branch — nothing to compare)"
        return
    fi

    local count
    count=$(git rev-list --count "$main_branch..$branch" 2>/dev/null || echo 0)
    echo "=== ${comp:-yggdrasil} ($branch, $count commits ahead of $main_branch) ==="

    if [[ "$count" -eq 0 ]]; then
        echo "(no commits ahead of $main_branch)"
        return
    fi

    local limit_flag=""
    [[ -n "$limit" ]] && limit_flag="-n $limit"
    if [[ -n "$oneline" ]]; then
        git log $limit_flag "$main_branch..$branch" --oneline
    else
        git log $limit_flag "$main_branch..$branch" --format="%h %s (%cr)"
    fi
}

ws_clean() {
    if [[ $# -gt 0 ]]; then
        echo "Usage: ws clean" >&2
        echo "" >&2
        echo "Remove draft files from .issues/, .crs/, .commits/, .outputs/," >&2
        echo "and the workspace scratch area .tmp/." >&2
        exit 1
    fi

    local total=0
    # Per-dir glob: bodyfile dirs hold *.md; .outputs/ holds tool-emitted
    # snapshots in *.txt. Each spec is `<dir>:<glob>`. The shallow
    # find pattern leaves nested directories alone — those don't
    # exist in these directories by convention.
    local spec
    for spec in '.issues:*.md' '.crs:*.md' '.commits:*.md' '.outputs:*.txt'; do
        local dir="${spec%%:*}"
        local pattern="${spec#*:}"
        local dirpath="$ROOT_DIR/$dir"
        if [[ -d "$dirpath" ]]; then
            local count
            count=$(find "$dirpath" -maxdepth 1 -name "$pattern" -type f | wc -l)
            if [[ "$count" -gt 0 ]]; then
                find "$dirpath" -maxdepth 1 -name "$pattern" -type f -delete
                echo "  $dir/  $count file(s) removed"
                total=$((total + count))
            fi
        fi
    done

    # .tmp/ — workspace scratch area for ad-hoc validation and
    # write-then-execute script use. Unlike the bodyfile dirs above,
    # contents are arbitrary and often nested (synthetic git repos,
    # test fixtures, generated scripts), so recursive cleanup is
    # appropriate. We blow away top-level entries and recreate
    # nothing — the directory itself stays for next-use.
    local tmp_dir="$ROOT_DIR/.tmp"
    if [[ -d "$tmp_dir" ]]; then
        local tmp_count
        tmp_count=$(find "$tmp_dir" -mindepth 1 -maxdepth 1 | wc -l)
        if [[ "$tmp_count" -gt 0 ]]; then
            find "$tmp_dir" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
            echo "  .tmp/  $tmp_count entr(ies) removed"
            total=$((total + tmp_count))
        fi
    fi

    if [[ "$total" -eq 0 ]]; then
        echo "(no draft files to clean)"
    else
        echo "Cleaned $total draft file(s) total."
    fi
}

ws_issue() {
    if [[ $# -lt 4 || $# -gt 5 ]]; then
        echo "Usage: ws issue <component> [remote] <title> <label> <bodyfile>" >&2
        echo "  remote auto-detects if single remote, uses forkOrg if multiple." >&2
        exit 1
    fi
    local comp="$1"
    shift
    ws_validate_component "$comp"
    local remote=""
    if [[ $# -eq 4 ]]; then
        remote="$1"
        shift
    else
        # Let git-issue.sh auto-detect; pass forkOrg as hint for multi-remote
        remote=$(ws_resolve_fork_org)
        # remote may be empty — git-issue.sh handles auto-detect for single remote
    fi
    bash "$SCRIPT_DIR/git-issue.sh" "$COMPONENT_DIR" "$remote" "$@"
}

ws_diagnose() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: ws diagnose <component|yggdrasil>" >&2
        echo "  Shows ecosystem config, clone status, remotes, provider, and token coverage." >&2
        echo "  Run this when 'ws push' or 'ws cr' fails with auth or remote errors." >&2
        exit 1
    fi
    local comp="$1"
    local eco
    eco=$(ws_resolve_ecosystem)

    echo "[ ws diagnose: $comp ]"
    echo ""

    # Special case: yggdrasil is the workspace root, not a declared component
    local comp_dir
    if [[ "$comp" == "yggdrasil" ]]; then
        comp_dir="$ROOT_DIR"
        echo "  Workspace root (not a declared ecosystem component)"
    else
        # Ecosystem entry
        local repo tier
        repo=$(COMP="$comp" yq '.components[strenv(COMP)].repo // ""' "$eco" 2>/dev/null)
        [[ "$repo" == "null" ]] && repo=""
        tier=$(COMP="$comp" yq '.components[strenv(COMP)].tier // ""' "$eco" 2>/dev/null)
        [[ "$tier" == "null" ]] && tier=""

        if [[ -z "$repo" ]]; then
            echo "  ✗ Not declared in ecosystem config."
            echo "    Add it to ecosystem.local.yaml under 'components:'."
            echo "    Run 'ws list' to see declared components."
            return 1
        fi
        echo "  Ecosystem repo : $repo"
        [[ -n "$tier" ]] && echo "  Tier           : $tier"
        comp_dir="$COMPONENTS_DIR/$comp"
    fi
    if [[ -d "$comp_dir/.git" ]]; then
        local branch
        branch=$(git -C "$comp_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "(unknown)")
        echo "  Clone          : ✓ present (branch: $branch)"
    else
        echo "  Clone          : ✗ not cloned — run: ws clone $comp"
        echo ""
        return 0
    fi

    # Remotes
    echo ""
    echo "  Remotes:"
    local fork_org
    fork_org=$(ws_resolve_fork_org)
    while IFS= read -r remote; do
        local url
        url=$(git -C "$comp_dir" remote get-url "$remote" 2>/dev/null || echo "(no url)")
        local push_marker=""
        [[ -n "$fork_org" && "${remote,,}" == "${fork_org,,}" ]] && push_marker=" ← push/cr remote (identity.forkOrg)"
        echo "    $remote → $url$push_marker"
    done < <(git -C "$comp_dir" remote)

    # Token coverage per remote
    source "$SCRIPT_DIR/git-provider.sh"
    local map_count=0
    [[ -f "$eco" ]] && map_count=$(yq '.defaults.gitTokens | length' "$eco" 2>/dev/null || echo 0)

    echo ""
    echo "  Token coverage:"
    while IFS= read -r remote; do
        local url
        url=$(git -C "$comp_dir" remote get-url "$remote" 2>/dev/null || continue)

        local provider
        provider=$(gp_detect "$url" "$eco" 2>/dev/null) || provider="unknown"

        # Normalize URL the same way gp_set_token_for_url does
        local normalized
        normalized=$(echo "$url" \
            | sed 's|^ssh://[^@]*@\([^:/]*\)[^/]*/|\1/|; s|^https://[^@]*@||; s|^http://[^@]*@||; s|^https://||; s|^http://||; s|^git@\([^:]*\):|/\1/|; s|^/||; s|\.git$||')

        local best_var="" best_len=0
        if [[ "$map_count" -gt 0 ]]; then
            while IFS= read -r key; do
                [[ -z "$key" || "$key" == "null" ]] && continue
                local key_len=${#key}
                if [[ ( "$normalized" == "${key}/"* || "$normalized" == "$key" ) && $key_len -gt $best_len ]]; then
                    best_len=$key_len
                    best_var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$eco" 2>/dev/null)
                fi
            done < <(yq '.defaults.gitTokens | keys | .[]' "$eco" 2>/dev/null)
        fi

        local token_status
        if [[ -n "$best_var" && "$best_var" != "null" ]]; then
            local token_val="${!best_var:-}"
            if [[ -n "$token_val" ]]; then
                token_status="✓ $best_var is set"
            else
                token_status="✗ $best_var is NOT SET — add 'export $best_var=<token>' to .env"
            fi
        else
            # No gitTokens entry. For known providers, fall back to the
            # default env var their CLI reads automatically (gh →
            # GH_TOKEN, glab → GITLAB_TOKEN). Only report a missing
            # entry as a problem for unknown providers — GitHub
            # remotes with no gitTokens map are the common case, not
            # an error. (False-alarm fix: was reporting "no gitTokens
            # entry matches" for vanilla GitHub remotes that work
            # fine via $GH_TOKEN.)
            local default_var=""
            case "$provider" in
                github) default_var="GH_TOKEN" ;;
                gitlab) default_var="GITLAB_TOKEN" ;;
            esac
            if [[ -n "$default_var" ]]; then
                local default_val="${!default_var:-}"
                if [[ -n "$default_val" ]]; then
                    token_status="✓ $default_var is set (default for $provider; no gitTokens entry needed)"
                else
                    # Note: $default_var being unset doesn't necessarily mean
                    # `gh`/`glab` will fail — interactive `gh auth login` /
                    # `glab auth login` stores credentials separately. But
                    # agent / non-interactive flows (ws push, ws cr, ws review)
                    # need the env var, so we still flag it.
                    token_status="✗ $default_var is NOT SET — required for agent/non-interactive ops (ws push, ws cr, ws review). Add 'export $default_var=<token>' to .env. Interactive 'gh auth login' / 'glab auth login' may still work for direct CLI use."
                fi
            else
                token_status="✗ no gitTokens entry matches normalized path: $normalized"
                token_status+=$'\n'"      → Add an entry to defaults.gitTokens in ecosystem.local.yaml"
            fi
        fi

        echo "    $remote ($provider): $token_status"
    done < <(git -C "$comp_dir" remote)

    echo ""
}

ws_gitlab_auth() {
    local eco
    eco=$(ws_resolve_ecosystem)

    local host="${GITLAB_HOST:-}"
    if [[ -z "$host" ]]; then
        echo "ERROR: GITLAB_HOST is not set." >&2
        echo "  Add 'export GITLAB_HOST=your-gitlab-host' to .env" >&2
        exit 1
    fi

    # --status: show token coverage without making any changes
    if [[ "${1:-}" == "--status" ]]; then
        echo "[ ws gitlab-auth --status: $host ]"
        echo ""
        echo "Configured token slots (from defaults.gitTokens in ecosystem config):"
        local found=0
        while IFS= read -r key; do
            [[ -z "$key" || "$key" == "null" ]] && continue
            [[ "$key" != "$host/"* ]] && continue
            local var
            var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$eco")
            [[ -z "$var" || "$var" == "null" ]] && continue
            local val="${!var:-}"
            found=1
            if [[ -n "$val" ]]; then
                echo "  ✓ $var (set) — covers $key"
            else
                echo "  ✗ $var (NOT SET) — covers $key"
                echo "    → Add 'export $var=<token>' to .env, then re-run: ws gitlab-auth"
            fi
        done < <(yq '.defaults.gitTokens | keys | .[]' "$eco" 2>/dev/null)
        if [[ "$found" -eq 0 ]]; then
            echo "  (none — add entries to defaults.gitTokens in ecosystem.local.yaml)"
        fi
        echo ""
        echo "Tip: run 'ws diagnose <comp>' to see which token covers a specific component."
        return 0
    fi

    # Find forkOrg to identify the write (Developer) token
    local fork_org
    fork_org=$(yq '.identity.forkOrg // ""' "$eco")
    [[ "$fork_org" == "null" ]] && fork_org=""
    if [[ -z "$fork_org" ]]; then
        echo "ERROR: identity.forkOrg is not set in ecosystem config." >&2
        exit 1
    fi

    # Find gitTokens entry whose key is host/<...>/forkOrg (exact leaf match)
    local write_token_var="" write_key=""
    while IFS= read -r key; do
        [[ -z "$key" || "$key" == "null" ]] && continue
        [[ "$key" != "$host/"* ]] && continue
        local leaf="${key##*/}"
        if [[ "$leaf" == "$fork_org" ]]; then
            if [[ ${#key} -gt ${#write_key} ]]; then
                write_key="$key"
                write_token_var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$eco")
            fi
        fi
    done < <(yq '.defaults.gitTokens | keys | .[]' "$eco" 2>/dev/null)

    if [[ -z "$write_token_var" || "$write_token_var" == "null" ]]; then
        echo "ERROR: No gitTokens entry found for host '$host' and forkOrg '$fork_org'." >&2
        echo "  Expected a key like: $host/<group-path>/$fork_org" >&2
        echo "  Add it to defaults.gitTokens in ecosystem.local.yaml." >&2
        exit 1
    fi

    local write_token="${!write_token_var:-}"
    if [[ -z "$write_token" ]]; then
        echo "ERROR: Token env var '$write_token_var' is not set in environment." >&2
        echo "  Add it to .env (see docs/git-provider-setup.md)." >&2
        exit 1
    fi

    echo "[ ws gitlab-auth: $host ]"
    echo ""

    # 1. Register write token with glab
    echo "1. Registering write token ($write_token_var) with glab..."
    if glab auth login --hostname "$host" --token "$write_token" 2>/dev/null; then
        echo "   ✓ glab authenticated"
    else
        echo "   ✗ glab auth login failed" >&2
        exit 1
    fi

    # 2. Store write token in git credential helper for HTTPS clone/push
    echo "2. Storing write token in git credential helper..."
    git credential approve <<EOF
protocol=https
host=$host
username=oauth2
password=$write_token
EOF
    echo "   ✓ Stored in $(git config --global credential.helper || echo 'credential store') for $host"

    # 3. Verify with git ls-remote on a declared component URL
    echo "3. Verifying git access..."
    local test_url=""
    while IFS= read -r comp_url; do
        [[ -z "$comp_url" || "$comp_url" == "null" ]] && continue
        [[ "$comp_url" == "https://$host/"* ]] && test_url="$comp_url" && break
    done < <(yq '.components[].repo // ""' "$eco" 2>/dev/null)

    if [[ -n "$test_url" ]]; then
        if git ls-remote "$test_url" HEAD &>/dev/null; then
            echo "   ✓ git access verified ($test_url)"
        else
            echo "   ✗ git ls-remote failed: $test_url" >&2
            echo "   Token may lack read access to this repo." >&2
            exit 1
        fi
    else
        echo "   (skipped — no component URLs in ecosystem config to test against)"
    fi

    # 4. Report other configured tokens
    local other_count=0
    while IFS= read -r key; do
        [[ -z "$key" || "$key" == "null" || "$key" == "$write_key" ]] && continue
        [[ "$key" != "$host/"* ]] && continue
        local other_var
        other_var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$eco")
        [[ -z "$other_var" || "$other_var" == "null" ]] && continue
        local other_val="${!other_var:-}"
        if [[ -n "$other_val" ]]; then
            echo "   ✓ Additional token $other_var available for $key"
        else
            echo "   ✗ Additional token $other_var (for $key) is not set in environment" >&2
        fi
        other_count=$((other_count + 1))
    done < <(yq '.defaults.gitTokens | keys | .[]' "$eco" 2>/dev/null)

    echo ""
    echo "Done. Run 'ws clone <component>' to continue."
}

COMMAND="${1:-help}"
shift 2>/dev/null || true

# Allow `ws help <subcommand> [args]` as an alias for `ws <subcommand>
# --help [args]`. New sessions reach for either form depending on
# habit; both should reach per-subcommand help. This rewrite happens
# before the dispatch case so the subcommand handler does the actual
# help work — keeps each subcommand the source of truth for its own
# help text.
if [[ ( "$COMMAND" == "help" || "$COMMAND" == "--help" || "$COMMAND" == "-h" ) && $# -gt 0 ]]; then
    COMMAND="$1"
    shift
    set -- "--help" "$@"
fi

case "$COMMAND" in
    help|--help|-h)
        ws_help
        ;;
    list)
        bash "$SCRIPT_DIR/ws-list.sh" "$@"
        ;;
    status)
        bash "$SCRIPT_DIR/ws-status.sh" "$@"
        ;;
    clone)
        bash "$SCRIPT_DIR/ws-clone.sh" "$@"
        ;;
    pull)
        bash "$SCRIPT_DIR/ws-pull.sh" "$@"
        ;;
    resolve)
        bash "$SCRIPT_DIR/ws-resolve.sh" "$@"
        ;;
    vscode)
        bash "$SCRIPT_DIR/ws-vscode.sh" "$@"
        ;;
    push)
        ws_push "$@"
        ;;
    cr)
        ws_cr "$@"
        ;;
    issue)
        ws_issue "$@"
        ;;
    test)
        bash "$SCRIPT_DIR/ws-test.sh" "$@"
        ;;
    review)
        bash "$SCRIPT_DIR/ws-review.sh" "$@"
        ;;
    commit)
        bash "$SCRIPT_DIR/ws-commit.sh" "$@"
        ;;
    log)
        ws_log "$@"
        ;;
    clean)
        ws_clean "$@"
        ;;
    exec)
        ws_exec "$@"
        ;;
    realm)
        bash "$SCRIPT_DIR/ws-realm.sh" "$@"
        ;;
    hoard)
        bash "$SCRIPT_DIR/ws-hoard.sh" "$@"
        ;;
    component)
        bash "$SCRIPT_DIR/ws-component.sh" "$@"
        ;;
    gitlab-auth)
        ws_gitlab_auth "$@"
        ;;
    diagnose)
        ws_diagnose "$@"
        ;;
    preflight)
        bash "$SCRIPT_DIR/ws-preflight.sh" "$@"
        ;;
    audit-permissions)
        bash "$SCRIPT_DIR/ws-audit-permissions.sh" "$@"
        ;;
    actions)
        bash "$SCRIPT_DIR/ws-realm.sh" actions "$@"
        ;;
    mcp-setup)
        bash "$SCRIPT_DIR/ws-mcp-setup.sh" "$@"
        ;;
    mcp-status)
        bash "$SCRIPT_DIR/ws-mcp-setup.sh" --status
        ;;
    *)
        echo "ERROR: Unknown command '$COMMAND'. Run 'ws help' for usage." >&2
        exit 1
        ;;
esac
