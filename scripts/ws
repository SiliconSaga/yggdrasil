#!/usr/bin/env bash
# ws — Unified workspace CLI for yggdrasil
#
# Usage:
#   ws <command> [args...]
#   ws help
#
# Commands:
#   list              List ecosystem components (tier, repo, clone status)
#   orient            Deterministic "what can I do here?" menu — workspace
#                     toolset + active realm + adapters + skill index
#   status [--verbose] [--nested]  Git status across workspace
#                     --nested also git-statuses repos nested inside components
#   clone [comp|--all|--url <url> [--name N] [--add-to-ecosystem]] Clone components
#   clone-fork <comp>  Fork-aware clone: ensure fork exists, clone fork, wire
#                      both remotes, sync main with upstream. Idempotent.
#   clone-fork --url <url> [--name N] --add-to-ecosystem
#                      Same flow for an undeclared source repo — declares it
#                      in ecosystem.local.yaml on the way in.
#   pull [comp]       Pull all or one component
#   vscode            Generate VS Code workspace file
#   push [comp] [branch|tag] [--force] Push branch or tag (remote from identity.forkRemote)
#   cr <comp> [--remote <remote>] [--upstream] <title> <bodyfile>  Open a CR (change request/PR/MR)
#   issue <comp> [remote] <title> <label> <bodyfile> File issue (remote from forkRemote)
#   test <comp> [TestName|args...] Run tests (auto-detected; see 'ws actions <comp>')
#   lint <comp> [args...] Run the component linter (adapter commands.lint; see 'ws actions <comp>')
#   review <comp> <cr#|threads> [options]  CR review comments and threads (see ws review --help)
#   commit <comp> <bodyfile> Commit with Co-Authored-By trailer (bodyfile-driven; see templates/commit.md)
#   checkout <target> <branch> [-b|--create]  Switch/create a branch (branches only, never paths)
#   log [target] [--oneline] [--stat] [--limit N] [--against <ref>] [--incoming]
#                     Commits on this branch vs the trunk, or what a pull would bring in
#   clean [--force]   Remove draft files from .issues/, .crs/, .commits/, .outputs/, .tmp/ (holds off below the mining threshold unless --force)
#   k8s scope set|show|clear / k8s <args>   Guarded kubectl: prevalidate context + namespace
#   docker <args>     Run docker with Windows/MSYS path conversion handled automatically
#   whoami [--set "Name <email>"]  Show/set this session's commit identity
#   session get|set|show         Get/set this session's stance/role/mentoring config
#   exec <comp> <cmd...> Run a command in a component dir
#   realm init        Clone template realm for tutorials
#   realm <url>       Clone a community realm
#   realm use <name>  Set active realm
#   realm list        Show available realms
#   hoard init [template] [--name <name>]   Scaffold a new hoard (default template: thalami)
#   hoard <url>                Clone an existing hoard
#   hoard list                 Show hoards and which thalami hoard is active
#   hoard upgrade <hoard> [--plan|--apply|--rollback] [--template <name>]  Provenance-tracked plugin/config upgrade
#   hoard lock <template> [--plugin <id>]  Refresh pinned plugin release SHA-256 locks
#   component init <flavor> [name]   Scaffold a new component from a template
#   component list                   Show known component flavors
#   actions <comp>    List adapter commands for a component
#   preflight [--soft]  Check workspace prerequisites (bash, git, yq, jq, gh/glab)
#   audit-permissions [--names-only]  Flag broad permissions.allow patterns across all 3 scopes
#   mcp-setup [--dry-run]  Generate .mcp.json from realm mcp.servers declarations
#   mcp-status        Show currently configured MCP servers
#   hook-bypass <slug> [--reason "<text>"]  Write a session-scoped bypass marker
#                     for a Tier 2 redirect-deny slug. See `ws hook-bypass --help`.
#   help              Show this help message (or `ws help <subcommand>` for per-command help)
#
# Auth commands (run these before ws cr / raw provider debugging):
#   gitlab-auth [--status]  Configure glab + optional git credentials from .env tokens.
#                           --status: show which token env vars are set/unset (no changes made).
#   gh <args...>            Run the GitHub CLI (gh) with the .env token injected
#                           (no interactive gh auth login; one auditable entry point).
#   glab <args...>          Run the GitLab CLI (glab) with the .env token injected.
#   diagnose <comp>         Show ecosystem entry, clone status, remotes, provider detection,
#                           and which gitToken env var covers each remote (set or missing).
#                           Run this when push/cr fails with auth or remote errors.
#
# First-time setup:
#   1. Add tokens to .env  (see docs/git-provider-setup.md for token scopes)
#   2. source .env
#   3. ws gitlab-auth       (self-hosted GitLab API setup; optional git credential cache)
#   4. ws clone <comp>
#   5. ws diagnose <comp>   (verify token coverage before pushing)
#
# For shorthand access, add to your shell profile:
#   export PATH="<yggdrasil>/scripts:$PATH"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Honor a pre-set ROOT_DIR (matches ws-commit.sh) so tests can point the
# dispatcher at an isolated workspace. Unset in normal use, so this
# resolves to the script's parent — behavior-preserving in production.
: "${ROOT_DIR:="$(cd "$SCRIPT_DIR/.." && pwd)"}"
: "${ECOSYSTEM:="$ROOT_DIR/ecosystem.yaml"}"
: "${ECOSYSTEM_LOCAL:="$ROOT_DIR/ecosystem.local.yaml"}"
: "${REALMS_DIR:="$ROOT_DIR/realms"}"
: "${COMPONENTS_DIR:="$ROOT_DIR/components"}"
# Export ECOSYSTEM_LOCAL so non-exported caller-side overrides
# (`ECOSYSTEM_LOCAL=/foo ws ...`) propagate to every child script
# without each one independently re-deriving the path.
export ECOSYSTEM_LOCAL
# Load .env assignments as literal data so tokens are available to all
# subcommands without evaluating the file as shell code.
# shellcheck source=ws-env.sh
source "$SCRIPT_DIR/ws-env.sh"
ws_load_env "$ROOT_DIR/.env"

# Source shared functions (ws_resolve_target, ws_detect_realm,
# ws_resolve_ecosystem, COMPONENT_DIR, etc.)
# shellcheck source=ws-realm.sh
source "$SCRIPT_DIR/ws-realm.sh"

# Per-session identity helpers (ws_session_identity_path, etc.) — needed
# by ws_clean's carve-out and the commit path.
# shellcheck source=ws-session.sh
source "$SCRIPT_DIR/ws-session.sh"

ws_help() {
    sed -n '/^# Usage:$/,/^$/p' "${BASH_SOURCE[0]}" | grep '^#' | sed 's/^# \?//'
}

# Resolve identity.forkRemote from merged ecosystem config.
# Returns the fork remote name (e.g. "SiliconSaga") or empty string.
_ws_fork_remote="" # cached
ws_resolve_fork_remote() {
    if [[ -n "$_ws_fork_remote" ]]; then
        echo "$_ws_fork_remote"
        return
    fi
    local eco
    eco="$(ws_resolve_ecosystem 2>/dev/null)" || return 0
    _ws_fork_remote=$(yq '.identity.forkRemote // ""' "$eco" 2>/dev/null)
    [[ "$_ws_fork_remote" == "null" ]] && _ws_fork_remote=""
    echo "$_ws_fork_remote"
}

ws_exec() {
    # ws:use-when running a one-off command inside a component dir
    # --help only as $1 — anywhere-in-args would intercept flags meant
    # for the wrapped command (e.g. `ws exec nordri git --help`).
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<'HELP'
Usage: ws exec <component> <command...>

  component  Component, realm, or hoard whose dir to run in
  command    Command + args to run inside that dir

Runs a one-off command inside the target dir without manual cd.
For complex commands, use a Makefile target or shell script.
HELP
        return 0
    fi
    if [[ $# -lt 2 ]]; then
        echo "Usage: ws exec <component> <command...>" >&2
        exit 1
    fi
    local comp="$1"
    shift
    ws_resolve_target "$comp"
    cd "$COMPONENT_DIR" && "$@"
}

ws_push() {
    # ws:use-when sending git changes to its remote repo
    # Detect --help/-h anywhere in args (e.g. `ws push my-comp --help`),
    # not just $1, so the typical UNIX-y "any position" form works.
    local _arg
    for _arg in "$@"; do
        if [[ "$_arg" == "--help" || "$_arg" == "-h" ]]; then
            cat <<'HELP'
Usage: ws push [component] [--remote <remote>] [branch|tag] [--force]

  component        Component to push (default: yggdrasil)
  --remote <name>  Push to this git remote instead of identity.forkRemote
  branch|tag       Component branch or local tag to push (default: current branch)
  --force          Force push a branch (use with care; refused for tags)

Pushes to the component's per-developer fork remote (resolved via
identity.forkRemote in ecosystem config). For repos you own directly,
pushes to the configured remote. Use --remote to target a specific remote
(e.g. `ws push yggdrasil --remote siliconsaga` to push to GitHub when
identity.forkRemote points at a GitLab fork).
HELP
            return 0
        fi
    done
    local comp="yggdrasil"
    local comp_set=0
    local branch=""
    local force=""
    local push_remote_override=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force) force="--force" ;;
            --remote)
                if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
                    echo "ERROR: --remote requires a git remote name" >&2
                    exit 1
                fi
                push_remote_override="$2"
                shift
                ;;
            --remote=*)
                push_remote_override="${1#--remote=}"
                if [[ -z "$push_remote_override" ]]; then
                    echo "ERROR: --remote requires a git remote name" >&2
                    exit 1
                fi
                ;;
            -*) echo "ERROR: Unknown option '$1'" >&2; exit 1 ;;
            *)
                if [[ $comp_set -eq 0 ]]; then
                    comp="$1"
                    comp_set=1
                elif [[ -z "$branch" ]]; then
                    branch="$1"
                else
                    echo "ERROR: Too many positional arguments" >&2; exit 1
                fi
                ;;
        esac
        shift
    done
    ws_resolve_target "$comp"
    # --remote flag takes precedence; otherwise fall back to identity.forkRemote
    if [[ -n "$push_remote_override" ]]; then
        export GIT_PUSH_REMOTE="$push_remote_override"
    else
        local fork_remote
        fork_remote=$(ws_resolve_fork_remote)
        if [[ -n "$fork_remote" && -z "${GIT_PUSH_REMOTE:-}" ]]; then
            export GIT_PUSH_REMOTE="$fork_remote"
        fi
    fi
    cd "$COMPONENT_DIR" && bash "$SCRIPT_DIR/git-push.sh" ${force:+"$force"} ${branch:+"$branch"}
}

ws_cr() {
    # ws:use-when opening a code-review request (PR / MR) - must use bodyfile from change.md template
    local _arg
    for _arg in "$@"; do
        if [[ "$_arg" == "--help" || "$_arg" == "-h" ]]; then
            cat <<'HELP'
Usage: ws cr <component> [--remote <remote>] [--source-branch <branch>] [--upstream] [--stale-base-ok] <title> <bodyfile>

  component   Component, realm, or hoard to open the CR against
  --remote    Use this git remote as the fork/head remote for this CR
  --source-branch
              Submit this local, remote-tracked branch instead of current HEAD
  --upstream  Target the upstream repo instead of the fork remote
  --stale-base-ok
              Skip the stale-base preflight (deliberate stacked CRs etc.)
  title       CR (PR / MR) title
  bodyfile    Path (relative to workspace root) to a change bodyfile
              — see templates/change.md

Opens a code-review request via git-cr.sh. The current branch is used unless
--source-branch selects another pushed branch from the same repository. Before
creating, the live target-branch tip is verified to exist and be contained in
the source branch — a moved target fails with a rebase pointer, a missing
target fails closed; --stale-base-ok skips the preflight either way.
HELP
            return 0
        fi
    done
    if [[ $# -lt 3 || $# -gt 9 ]]; then
        echo "Usage: ws cr <component> [--remote <remote>] [--source-branch <branch>] [--upstream] [--stale-base-ok] <title> <bodyfile>" >&2
        exit 1
    fi
    local comp="$1"
    shift
    ws_resolve_target "$comp"
    local cr_remote=""
    local source_branch=""
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --remote)
                if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
                    echo "ERROR: --remote requires a git remote name" >&2
                    exit 1
                fi
                cr_remote="$2"
                shift 2
                ;;
            --remote=*)
                cr_remote="${1#--remote=}"
                if [[ -z "$cr_remote" || "$cr_remote" == -* ]]; then
                    echo "ERROR: --remote requires a git remote name" >&2
                    exit 1
                fi
                shift
                ;;
            --source-branch)
                if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
                    echo "ERROR: --source-branch requires a branch name" >&2
                    exit 1
                fi
                source_branch="$2"
                shift 2
                ;;
            --source-branch=*)
                source_branch="${1#--source-branch=}"
                if [[ -z "$source_branch" || "$source_branch" == -* ]]; then
                    echo "ERROR: --source-branch requires a branch name" >&2
                    exit 1
                fi
                shift
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done
    if [[ ${#args[@]} -lt 2 || ${#args[@]} -gt 4 ]]; then
        echo "Usage: ws cr <component> [--remote <remote>] [--source-branch <branch>] [--upstream] [--stale-base-ok] <title> <bodyfile>" >&2
        exit 1
    fi
    # Resolve bodyfile path before cd (last arg is always the bodyfile)
    local last_idx=$(( ${#args[@]} - 1 ))
    if [[ "${args[$last_idx]}" != /* ]]; then
        args[$last_idx]="$ROOT_DIR/${args[$last_idx]}"
    fi
    if [[ -n "$cr_remote" ]]; then
        export GIT_CR_REMOTE="$cr_remote"
    fi
    if [[ -n "$source_branch" ]]; then
        export GIT_CR_SOURCE_BRANCH="$source_branch"
    fi
    cd "$COMPONENT_DIR" && bash "$SCRIPT_DIR/git-cr.sh" "${args[@]}"
}


ws_checkout() {
    # ws:use-when switching or creating a branch, including inside a nested repo
    # Detect --help anywhere in args.
    for _arg in "$@"; do
        if [[ "$_arg" == "--help" || "$_arg" == "-h" ]]; then
            cat <<'HELP'
Usage: ws checkout <target> <branch> [-b|--create]

Switch a component, realm, hoard or nested repo to a branch.

Branches only. This deliberately cannot restore paths the way `git checkout --
<path>` does, because that silently discards working-tree changes; do that by
hand, on purpose, when you mean it.

The target accepts the same names as every other repo-touching verb, so nested
repos work here too: `ws checkout terasology/modules/Cooking fix/x -b` branches
the module in place, inside the tree where it actually builds.

Options:
  -b, --create        Create the branch and switch to it

Examples:
  ws checkout yggdrasil main                        # the workspace root
  ws checkout terasology fix/assets -b              # a component
  ws checkout terasology/modules/Cooking fix/x -b   # a nested module repo
HELP
            return 0
        fi
    done

    local create="" target="" branch=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -b|--create) create="yes"; shift ;;
            --)
                echo "ERROR: 'ws checkout' switches branches only; it does not restore paths." >&2
                echo "  Restoring a path discards working-tree changes. Do that with git, deliberately." >&2
                exit 1 ;;
            -*)
                echo "ERROR: Unknown option '$1'" >&2
                exit 1 ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                elif [[ -z "$branch" ]]; then
                    branch="$1"
                else
                    echo "ERROR: Unexpected argument '$1'." >&2
                    echo "  Usage: ws checkout <target> <branch> [-b|--create]" >&2
                    exit 1
                fi
                shift ;;
        esac
    done

    if [[ -z "$target" || -z "$branch" ]]; then
        echo "ERROR: ws checkout requires a target and a branch." >&2
        echo "  Usage: ws checkout <target> <branch> [-b|--create]" >&2
        exit 1
    fi

    # The name reaches git as an argument, never a shell word, so this is not
    # about injection - it rejects the shapes that make a branch ambiguous with
    # a path, which is where a typo turns into a surprising checkout.
    if [[ "$branch" == *".."* || "$branch" == /* || "$branch" == */ ]]; then
        echo "ERROR: Invalid branch name '$branch'." >&2
        exit 1
    fi

    ws_resolve_target "$target"
    cd "$COMPONENT_DIR"

    # git switch, not git checkout: it has no path-restoring mode at all, so the
    # refusal above cannot be worked around by a name that looks like a file.
    if [[ -n "$create" ]]; then
        git switch -c "$branch"
    else
        git switch "$branch"
    fi
}

# The trunk this branch should be measured against. Order matters: what the
# remote calls its default branch beats convention, and `develop` is in the list
# because gitflow repos (Terasology among them) have no `main` at all — the old
# main/master-only check hard-failed there rather than degrading.
ws_log_detect_trunk() {
    local remote_head candidate
    remote_head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || remote_head=""
    if [[ -n "$remote_head" ]] && git rev-parse --verify --quiet "$remote_head" >/dev/null 2>&1; then
        printf '%s\n' "$remote_head"
        return 0
    fi
    for candidate in main master develop; do
        if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

ws_log() {
    # ws:use-when checking what commits are on a branch, incoming, or in a range
    # Detect --help anywhere in args.
    for _arg in "$@"; do
        if [[ "$_arg" == "--help" || "$_arg" == "-h" ]]; then
            cat <<'HELP'
Usage: ws log [target] [--oneline] [--stat] [--limit N] [--against <ref>] [--incoming]

Show commits on the current branch that aren't on the trunk.

The trunk is whatever the remote calls its default branch, else the first of
main, master, develop that exists. Pass --against to compare with something
else, or --incoming to ask the opposite question: what does the tracked remote
branch have that I don't?

Targets accept nested repos too, so `ws log terasology/modules/Cooking` works.

Options:
  --oneline           One line per commit (default: hash, subject, age)
  --stat              Also show the files each commit touched
  --limit N           Show only the most recent N commits
  --limit=N           Same; equals form also accepted
  --against <ref>     Compare against this ref instead of the detected trunk
  --incoming          Show what the upstream has that this branch does not

Examples:
  ws log                                  # yggdrasil branch vs its trunk
  ws log terasology --oneline             # a component on a develop trunk
  ws log terasology/modules/Cooking       # a nested module repo
  ws log app --against v1.2.0 --stat      # since a tag, with files
  ws log app --incoming                   # what a pull would bring in
HELP
            return 0
        fi
    done

    local comp="" oneline="" limit="" against="" incoming="" stat=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --oneline) oneline="yes"; shift ;;
            --stat) stat="yes"; shift ;;
            --incoming) incoming="yes"; shift ;;
            --against)
                [[ $# -ge 2 ]] || { echo "ERROR: --against requires a ref" >&2; exit 1; }
                against="$2"; shift 2 ;;
            --against=*)
                against="${1#--against=}"
                [[ -n "$against" ]] || { echo "ERROR: --against requires a ref" >&2; exit 1; }
                shift ;;
            --limit)
                [[ $# -ge 2 ]] || { echo "ERROR: --limit requires a value" >&2; exit 1; }
                if ! [[ "$2" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --limit value '$2' must be a non-negative integer" >&2
                    exit 1
                fi
                limit="$2"; shift 2 ;;
            --limit=*)
                limit="${1#--limit=}"
                if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --limit value '$limit' must be a non-negative integer" >&2
                    exit 1
                fi
                shift ;;
            -*)
                echo "ERROR: Unknown option '$1'" >&2
                exit 1 ;;
            *)
                if [[ -n "$comp" ]]; then
                    echo "ERROR: Multiple targets specified ('$comp' and '$1')." >&2
                    echo "  Usage: ws log [target] [--oneline] [--stat] [--limit N] [--against <ref>] [--incoming]" >&2
                    exit 1
                fi
                comp="$1"; shift ;;
        esac
    done

    if [[ -n "$incoming" && -n "$against" ]]; then
        echo "ERROR: --incoming already fixes the comparison; drop --against." >&2
        exit 1
    fi

    if [[ -n "$comp" ]]; then
        ws_resolve_target "$comp"
    else
        COMPONENT_DIR="$ROOT_DIR"
    fi

    cd "$COMPONENT_DIR"

    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
        echo "ERROR: Not on a branch (detached HEAD)." >&2
        exit 1
    fi

    local base range label
    if [[ -n "$incoming" ]]; then
        if ! base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || [[ -z "$base" ]]; then
            echo "ERROR: '$branch' has no upstream, so there is nothing to be incoming from." >&2
            echo "  Set one with: git branch --set-upstream-to <remote>/<branch>" >&2
            exit 1
        fi
        # Reversed on purpose: what they have that we do not.
        range="$branch..$base"
        label="incoming from $base"
    else
        if [[ -n "$against" ]]; then
            if ! git rev-parse --verify --quiet "${against}^{commit}" >/dev/null 2>&1; then
                echo "ERROR: --against ref '$against' does not resolve in this repo." >&2
                exit 1
            fi
            base="$against"
        elif ! base=$(ws_log_detect_trunk); then
            echo "ERROR: Cannot find a trunk branch (looked for the remote default, then main, master, develop)." >&2
            echo "  Compare against something explicit with: ws log ${comp:-} --against <ref>" >&2
            exit 1
        fi

        if [[ "$branch" == "$base" ]]; then
            echo "(on $base — nothing to compare)"
            return
        fi
        range="$base..$branch"
        label="ahead of $base"
    fi

    local count
    count=$(git rev-list --count "$range" 2>/dev/null || echo 0)
    echo "=== ${comp:-yggdrasil} ($branch, $count commits $label) ==="

    if [[ "$count" -eq 0 ]]; then
        if [[ -n "$incoming" ]]; then
            echo "(nothing incoming from $base)"
        else
            echo "(no commits ahead of $base)"
        fi
        return
    fi

    local -a log_args=()
    [[ -n "$limit" ]] && log_args+=("-n" "$limit")
    if [[ -n "$oneline" ]]; then
        log_args+=("--oneline")
    else
        log_args+=("--format=%h %s (%cr)")
    fi
    [[ -n "$stat" ]] && log_args+=("--stat")
    git log "${log_args[@]}" "$range"
}

ws_clean() {
    # ws:use-when sweeping draft files from .commits/ .crs/ .issues/ .outputs/ .tmp/
    local force=0
    local clean_sessions=0
    local arg
    for arg in "$@"; do
        case "$arg" in
            --force) force=1 ;;
            --sessions) ;;  # accepted but no longer prunes; use --sessions-all to sweep ended sessions
            --sessions-all) clean_sessions=1 ;;
            -h|--help)
                echo "Usage: ws clean [--force] [--sessions-all]"
                echo ""
                echo "Remove draft files from .issues/, .crs/, .commits/, .outputs/,"
                echo "and the workspace scratch area .tmp/."
                echo ""
                echo "These scratch files double as mining material for the"
                echo "housekeeping 'mine scratch dirs' step, so ws clean holds off"
                echo "when fewer than \$WS_CLEAN_MINE_THRESHOLD files (default 50)"
                echo "would be removed. Pass --force to clean anyway — e.g. right"
                echo "after a mining pass, or when you explicitly want a clean slate."
                echo ""
                echo "Session identity files under .tmp/gdd-agent-sessions/ are"
                echo "SPARED by default — wiping them would break a concurrent"
                echo "session's commit identity (and any future per-session"
                echo "settings). Pass --sessions-all to also clear ended sessions'"
                echo "files (your own current session's file is still spared)."
                echo "Use --sessions-all only during deliberate housekeeping,"
                echo "once you've confirmed no other live sessions need them."
                echo "(--sessions is accepted for backwards compatibility but is now"
                echo "a no-op for session pruning; --sessions-all is the pruning form.)"
                return 0
                ;;
            *)
                echo "Usage: ws clean [--force] [--sessions-all]" >&2
                return 1
                ;;
        esac
    done

    # Below this many scratch files, clean holds off (unless --force) so
    # the files survive to be mined by the housekeeping "mine scratch
    # dirs" step instead of being cleared away reflexively. Env-override
    # for users who want a different floor.
    local threshold="${WS_CLEAN_MINE_THRESHOLD:-50}"
    if ! [[ "$threshold" =~ ^[0-9]+$ ]]; then
        echo "WARNING: WS_CLEAN_MINE_THRESHOLD='$threshold' is not a non-negative integer; using 50." >&2
        threshold=50
    fi

    # bodyfile dirs hold *.md; .outputs/ holds tool-emitted snapshots in
    # *.txt. Each spec is `<dir>:<glob>`. The shallow find leaves nested
    # directories alone — those don't exist here by convention.
    local bodyfile_specs=('.issues:*.md' '.crs:*.md' '.commits:*.md' '.outputs:*.txt')
    local tmp_dir="$ROOT_DIR/.tmp"

    # Session identity files live under .tmp/gdd-agent-sessions/. By default
    # the whole dir is spared: a plain `ws clean` from a finishing session
    # must not wipe a CONCURRENT session's identity (or future per-session
    # settings) out from under it — you can't tell ended from still-live.
    # With --sessions-all, ended sessions' files are swept, but the current
    # session's (`keep`) is still spared so the running agent survives.
    # `keep` is empty when no session id resolves (a human shell).
    local sessions_dir="$tmp_dir/gdd-agent-sessions"
    local keep; keep="$(ws_session_identity_path)"
    [[ -n "$keep" && -f "$keep" ]] || keep=""

    # Single scan: collect the exact paths to remove, so the threshold
    # decision and the deletion act on the same snapshot. Re-scanning at
    # delete time would risk deleting files that were never counted, or
    # proceeding after the live total dropped below the threshold.
    local candidates=()   # individual files in the bodyfile dirs
    local tmp_entries=()  # top-level entries under .tmp/ (may be dirs)
    local report=()
    local spec
    for spec in "${bodyfile_specs[@]}"; do
        local dir="${spec%%:*}"
        local pattern="${spec#*:}"
        local dirpath="$ROOT_DIR/$dir"
        [[ -d "$dirpath" ]] || continue
        local before=${#candidates[@]}
        local f
        while IFS= read -r f; do
            candidates+=("$f")
        done < <(find "$dirpath" -maxdepth 1 -name "$pattern" -type f)
        local n=$(( ${#candidates[@]} - before ))
        [[ "$n" -gt 0 ]] && report+=("  $dir/  $n file(s)")
    done
    if [[ -d "$tmp_dir" ]]; then
        local e
        while IFS= read -r e; do
            tmp_entries+=("$e")
        done < <(find "$tmp_dir" -mindepth 1 -maxdepth 1)
        [[ ${#tmp_entries[@]} -gt 0 ]] && report+=("  .tmp/  ${#tmp_entries[@]} entr(ies)")
    fi

    local total=$(( ${#candidates[@]} + ${#tmp_entries[@]} ))

    if [[ "$total" -eq 0 ]]; then
        echo "(no draft files to clean)"
        return 0
    fi

    # Below the mining threshold and not forced: push back instead of
    # cleaning. The decision is embedded here so callers don't depend on
    # remembering the convention — a reflexive clean gets a nudge, and
    # the agent decides whether to honor it (back off) or re-run with
    # --force (the user asked, or mining already happened).
    if [[ "$total" -lt "$threshold" && "$force" -eq 0 ]]; then
        echo "Holding off — only $total scratch file(s), below the mining threshold of $threshold:"
        printf '%s\n' "${report[@]}"
        echo ""
        echo "These accumulate as mining material for housekeeping. If this was a"
        echo "reflexive cleanup, leave them. To clean anyway (post-mining, or a"
        echo "deliberate clean slate), re-run: ws clean --force"
        return 0
    fi

    # Proceed: delete exactly the snapshot we counted. .tmp/ entries are
    # arbitrary and often nested (synthetic git repos, test fixtures,
    # generated scripts), so recursive removal; the .tmp/ dir itself stays
    # for next-use since we only remove its top-level entries.
    printf '%s\n' "${report[@]}"
    # Delete the snapshot with one rm per group (batched for speed,
    # quoted + `--` so paths with spaces or leading dashes stay intact).
    # Each group is length-guarded: one side can be empty even when
    # total > 0, and a bare "${arr[@]}" on an empty array trips `set -u`
    # on older bash.
    if [[ ${#candidates[@]} -gt 0 ]]; then
        rm -f -- "${candidates[@]}"
    fi
    # Tracks how many counted top-level entries we deliberately spared, so
    # the final tally reflects what was actually removed (see below). Session
    # files cleared under --sessions live inside the spared dir, so they're
    # counted separately and reported on their own line.
    local spared=0
    local sessions_cleared=0
    if [[ ${#tmp_entries[@]} -gt 0 ]]; then
        local e
        for e in "${tmp_entries[@]}"; do
            if [[ "$e" == "$sessions_dir" ]]; then
                # The session-identity dir is spared as a unit (it stays for
                # next use). Default: leave every file. --sessions-all: sweep its
                # children except the current session's `keep`. Either way the
                # dir itself is retained, so it counts as spared, not cleaned.
                spared=$(( spared + 1 ))
                if [[ "$clean_sessions" -eq 1 ]]; then
                    local child
                    while IFS= read -r child; do
                        [[ -n "$keep" && "$child" == "$keep" ]] && continue
                        rm -rf -- "$child"
                        sessions_cleared=$(( sessions_cleared + 1 ))
                    done < <(find "$e" -mindepth 1 -maxdepth 1)
                fi
            else
                rm -rf -- "$e"
            fi
        done
    fi

    echo "Cleaned $(( total - spared )) draft file(s) total."
    if [[ "$sessions_cleared" -gt 0 ]]; then
        echo "Also cleared $sessions_cleared ended session identity file(s) (current session kept)."
    fi
}

ws_issue() {
    # ws:use-when filing a tracker issue with labels and a bodyfile - must use issue.md template
    local _arg
    for _arg in "$@"; do
        if [[ "$_arg" == "--help" || "$_arg" == "-h" ]]; then
            cat <<'HELP'
Usage: ws issue <component> [remote] <title> <label> <bodyfile>

  component  Component, realm, or hoard to file the issue against
  remote     Optional; auto-detects if a single remote, else uses
             identity.forkRemote
  title      Issue title
  label      Issue label (must exist on the repo)
  bodyfile   Path (relative to workspace root) to an issue bodyfile
             — see templates/issue.md

Files a tracker issue with the Co-Authored-By context via git-issue.sh.
HELP
            return 0
        fi
    done
    if [[ $# -lt 4 || $# -gt 5 ]]; then
        echo "Usage: ws issue <component> [remote] <title> <label> <bodyfile>" >&2
        echo "  remote auto-detects if single remote, uses forkRemote if multiple." >&2
        exit 1
    fi
    local comp="$1"
    shift
    ws_resolve_target "$comp"
    local remote=""
    if [[ $# -eq 4 ]]; then
        remote="$1"
        shift
    else
        # Let git-issue.sh auto-detect; pass forkRemote as hint for multi-remote
        remote=$(ws_resolve_fork_remote)
        # remote may be empty — git-issue.sh handles auto-detect for single remote
    fi
    bash "$SCRIPT_DIR/git-issue.sh" "$COMPONENT_DIR" "$remote" "$@"
}

# Shared "create + store a token" guidance for a missing token var. Used by
# both branches of ws_diagnose's token-coverage report so the two copies can't
# drift. Emits two indented "→" lines (no trailing newline; caller joins).
_ws_pat_setup_lines() {
    local provider="$1" host="$2" var_name="$3"
    local pat_url
    pat_url=$(gp_pat_create_url "$provider" "$host" "GDD agent write token")
    printf '      → Create one (scopes pre-selected, opens in browser): %s\n' "$pat_url"
    printf "      → Then add 'export %s=<token>' to .env  (copy .env.example)" "$var_name"
}

# Health line for a token var that IS set: placeholder → warn + guide; else,
# unless api checks are off, verify the token against the provider API; else
# just report it as set. Args: var_name value provider host no_api.
_ws_token_status() {
    local var_name="$1" value="$2" provider="$3" host="$4" no_api="$5"
    if gp_token_is_placeholder "$value"; then
        printf '⚠ %s is set to the .env.example placeholder — replace it with a real token\n%s' \
            "$var_name" "$(_ws_pat_setup_lines "$provider" "$host" "$var_name")"
        return
    fi
    # Skip the live probe when asked (--no-api-check) or under bats, to keep the
    # test suite offline and deterministic (same guard style as _ws_footer).
    if [[ -n "$no_api" || -n "${BATS_TEST_NAME:-}" ]]; then
        printf '✓ %s is set (not verified — omit --no-api-check to test the token)' "$var_name"
        return
    fi
    local login rc
    login=$(gp_token_api_login "$provider" "$host" "$value")
    rc=$?
    case "$rc" in
        0) printf '✓ %s is valid (authenticated as %s)' "$var_name" "$login" ;;
        1) printf '✗ %s is set but REJECTED by %s — bad credentials (expired, wrong value, or missing scope)\n%s' \
               "$var_name" "$provider" "$(_ws_pat_setup_lines "$provider" "$host" "$var_name")" ;;
        3)
            [[ -n "$login" ]] || login="$provider probe failed without details"
            printf '⚠ %s is set (could not verify — %s)\n      → Retry outside the network sandbox or use --no-api-check for offline diagnosis.' \
                "$var_name" "$login"
            ;;
        *) printf '✓ %s is set (could not verify — %s CLI unavailable)' "$var_name" "$provider" ;;
    esac
}

ws_diagnose() {
    # ws:use-when investigating push/cr failures — remote + token coverage
    local _arg comp="" no_api=""
    for _arg in "$@"; do
        case "$_arg" in
            --help|-h)
                cat <<'HELP'
Usage: ws diagnose [--no-api-check] <component|realm|hoard|yggdrasil>

  target          Any resolvable workspace target — a declared ecosystem
                  component, a realm dir, a hoard dir, or yggdrasil itself
  --no-api-check  Skip the live token-validity probe (offline checks only).
                  Use when the network/provider is down, or when debugging
                  something unrelated to auth.

Shows ecosystem config (components only), clone status, remotes, provider,
and token coverage. By default a set token is verified against the provider
API; a placeholder or rejected token is flagged. Run this when 'ws push' or
'ws cr' fails with auth or remote errors.
HELP
                return 0
                ;;
            --no-api-check) no_api=1 ;;
            -*)
                echo "ws diagnose: unknown option '$_arg'" >&2
                echo "  Usage: ws diagnose [--no-api-check] <component|realm|hoard|yggdrasil>" >&2
                exit 1
                ;;
            *) [[ -z "$comp" ]] && comp="$_arg" ;;
        esac
    done
    if [[ -z "$comp" ]]; then
        echo "Usage: ws diagnose [--no-api-check] <component|realm|hoard|yggdrasil>" >&2
        echo "  Shows ecosystem config, clone status, remotes, provider, and token coverage." >&2
        echo "  Run this when 'ws push' or 'ws cr' fails with auth or remote errors." >&2
        exit 1
    fi
    local eco
    eco=$(ws_resolve_ecosystem)

    echo "[ ws diagnose: $comp ]"
    echo ""

    # Resolve the target dir via the shared multi-kind helper (accepts
    # component, realm, hoard, and yggdrasil). ws_resolve_target exits
    # non-zero with its own message if the name resolves to nothing.
    ws_resolve_target "$comp"
    local comp_dir="$COMPONENT_DIR"

    if [[ "$comp" == "yggdrasil" ]]; then
        echo "  Workspace root (not a declared ecosystem component)"
    elif [[ "$comp_dir" == "$COMPONENTS_DIR/"* ]]; then
        # Declared component — show ecosystem repo/tier.
        local repo tier
        repo=$(COMP="$comp" yq '.components[strenv(COMP)].repo // ""' "$eco" 2>/dev/null)
        [[ "$repo" == "null" ]] && repo=""
        tier=$(COMP="$comp" yq '.components[strenv(COMP)].tier // ""' "$eco" 2>/dev/null)
        [[ "$tier" == "null" ]] && tier=""
        [[ -n "$repo" ]] && echo "  Ecosystem repo : $repo"
        [[ -n "$tier" ]] && echo "  Tier           : $tier"
    else
        # Realm or hoard — no ecosystem entry; remotes + token coverage below
        # are what matter for push/cr diagnosis.
        echo "  Realm/hoard target (not a declared ecosystem component)"
    fi
    if [[ -d "$comp_dir/.git" ]]; then
        local branch
        branch=$(git -C "$comp_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "(unknown)")
        echo "  Clone          : ✓ present (branch: $branch)"
    else
        echo "  Clone          : ✗ not cloned — run: ws clone $comp"
        echo ""
        return 0
    fi

    # Working tree and branch position. These are the questions actually being
    # asked when someone runs diagnose before a push or CR — "is this ready to
    # send, and against what?" — which remotes and tokens alone cannot answer.
    local dirty_count
    dirty_count=$(git -C "$comp_dir" status --porcelain 2>/dev/null | wc -l | tr -d '[:space:]')
    if [[ "${dirty_count:-0}" -eq 0 ]]; then
        echo "  Working tree   : ✓ clean"
    else
        echo "  Working tree   : $dirty_count uncommitted change(s)"
    fi

    local tracking ahead behind
    if tracking=$(git -C "$comp_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) \
        && [[ -n "$tracking" ]]; then
        # left..right: left-only commits are what the upstream has and we don't.
        if read -r behind ahead < <(git -C "$comp_dir" rev-list --left-right --count "$tracking...HEAD" 2>/dev/null); then
            echo "  Tracking       : $tracking (ahead $ahead, behind $behind)"
        else
            echo "  Tracking       : $tracking"
        fi
    else
        echo "  Tracking       : none — the first push sets it"
    fi

    # Nested rollup, host components only. Deliberately a count and not a status
    # sweep: a component can nest well over a hundred repos, and git-statusing
    # them all is what `ws status <comp> --nested` is for.
    if [[ "$comp" != */* ]]; then
        local nested_count=0 _n
        while IFS= read -r _n; do
            [[ -n "$_n" ]] && nested_count=$((nested_count + 1))
        done < <(ws_nested_candidates "$comp" "$comp_dir" 2>/dev/null || true)
        if [[ "$nested_count" -gt 0 ]]; then
            echo "  Nested repos   : $nested_count — git status via: ws status $comp --nested"
        fi
    fi

    # Remotes
    echo ""
    echo "  Remotes:"
    local fork_remote
    fork_remote=$(ws_resolve_fork_remote)
    while IFS= read -r remote; do
        local url
        url=$(git -C "$comp_dir" remote get-url "$remote" 2>/dev/null || echo "(no url)")
        local push_marker=""
        [[ -n "$fork_remote" && "${remote,,}" == "${fork_remote,,}" ]] && push_marker=" ← push/cr remote (identity.forkRemote)"
        echo "    $remote → $url$push_marker"
    done < <(git -C "$comp_dir" remote)

    # Token coverage per remote
    source "$SCRIPT_DIR/git-provider.sh"

    echo ""
    echo "  Token coverage:"
    while IFS= read -r remote; do
        local url
        # `continue` must be outside the $() — inside it only exits the subshell,
        # leaving url='' and printing a bogus empty-URL row instead of skipping.
        if ! url=$(git -C "$comp_dir" remote get-url "$remote" 2>/dev/null); then
            continue
        fi

        local provider
        provider=$(gp_detect "$url" "$eco" 2>/dev/null) || provider="unknown"

        # Normalize URL the same way gp_set_token_for_url does
        local normalized
        normalized=$(echo "$url" \
            | sed 's|^ssh://[^@]*@\([^:/]*\)[^/]*/|\1/|; s|^https://[^/@]*@||; s|^http://[^/@]*@||; s|^https://||; s|^http://||; s|^git@\([^:]*\):|/\1/|; s|^/||; s|\.git$||')

        # Longest-prefix match against defaults.gitTokens
        # (shared with ws-clone-fork.sh via ws-realm.sh).
        local best_var
        best_var=$(ws_resolve_token_var "$normalized")

        local token_status
        if [[ -n "$best_var" && "$best_var" != "null" ]]; then
            local token_val="${!best_var:-}"
            if [[ -n "$token_val" ]]; then
                token_status=$(_ws_token_status "$best_var" "$token_val" "$provider" "${normalized%%/*}" "$no_api")
            else
                token_status="✗ $best_var is NOT SET"
                token_status+=$'\n'"$(_ws_pat_setup_lines "$provider" "${normalized%%/*}" "$best_var")"
            fi
        else
            # No gitTokens entry. For known providers, fall back to the
            # default env var their CLI reads automatically (gh →
            # GH_TOKEN, glab → GITLAB_TOKEN). Only report a missing
            # entry as a problem for unknown providers — GitHub
            # remotes with no gitTokens map are the common case, not
            # an error. (False-alarm fix: was reporting "no gitTokens
            # entry matches" for vanilla GitHub remotes that work
            # fine via $GH_TOKEN.)
            local default_var="" remote_host="${normalized%%/*}"
            case "$provider:$remote_host" in
                github:github.com) default_var="GH_TOKEN" ;;
                gitlab:gitlab.com) default_var="GITLAB_TOKEN" ;;
            esac
            if [[ -n "$default_var" ]]; then
                local default_val="${!default_var:-}"
                if [[ -n "$default_val" ]]; then
                    token_status=$(_ws_token_status "$default_var" "$default_val" "$provider" "${normalized%%/*}" "$no_api")
                else
                    # Note: $default_var being unset doesn't necessarily mean
                    # `gh`/`glab` will fail — interactive `gh auth login` /
                    # `glab auth login` stores credentials separately. But
                    # agent / non-interactive flows (ws push, ws cr, ws review)
                    # need the env var, so we still flag it.
                    token_status="✗ $default_var is NOT SET — required for agent/non-interactive ops (ws push, ws cr, ws review)."
                    token_status+=$'\n'"$(_ws_pat_setup_lines "$provider" "${normalized%%/*}" "$default_var")"
                    token_status+=$'\n'"      Interactive 'gh auth login' / 'glab auth login' may still work for direct CLI use, but agent flows need the .env var."
                fi
            else
                token_status="✗ no gitTokens entry matches normalized path: $normalized"
                token_status+=$'\n'"      → Add an entry to defaults.gitTokens in ecosystem.local.yaml"
            fi
        fi

        echo "    $remote ($provider): $token_status"
    done < <(git -C "$comp_dir" remote)

    # Identity sanity — flag unedited ecosystem.local.yaml placeholders before
    # they leak into CR / issue bodies (@HUMAN_ACCOUNT) or fork flows.
    local human_account fork_remote
    human_account=$(yq '.identity.human_account // ""' "$eco" 2>/dev/null)
    fork_remote=$(yq '.identity.forkRemote // ""' "$eco" 2>/dev/null)
    echo "  Identity:"
    if [[ -z "$human_account" || "$human_account" == "your-github-username" ]]; then
        echo "    ⚠ identity.human_account is ${human_account:-unset} — set it in ecosystem.local.yaml"
        echo "      (it fills @HUMAN_ACCOUNT in CR / issue bodies via ws cr / ws issue)"
    else
        echo "    ✓ human_account: $human_account"
    fi
    if [[ "$fork_remote" == "your-fork-remote-name" ]]; then
        echo "    ⚠ identity.forkRemote is still the placeholder (only needed for ws clone-fork / fork CR flows)"
    fi

    echo ""
}

ws_gitlab_auth() {
    # ws:use-when configuring glab + git credentials from .env tokens

    # Help must short-circuit ahead of every precondition — on a machine with
    # no GITLAB_HOST, `ws gitlab-auth --help` is exactly the command a user
    # runs to find out whether they need this at all.
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<'HELP'
Usage: ws gitlab-auth [--status]

Configure glab + optional git credentials for a GitLab host from .env tokens.
Requires GITLAB_HOST — add 'export GITLAB_HOST=<your-gitlab-host>' to .env.

  (no args)   Register the fork-home write token with glab, store path-scoped
              git credentials for the source and fork namespaces, and verify
              access with the source token.
  --status    Show which gitTokens env vars are set/unset (no changes made).

Only needed for GitLab API setup (typically self-hosted instances); GitHub
and token-injected git operations work from .env without this step.
See docs/git-provider-setup.md for token scopes and .env layout.
HELP
        return 0
    fi

    local eco
    eco=$(ws_resolve_ecosystem)
    local auth_eco
    auth_eco=$(ws_resolve_local_ecosystem)

    local host="${GITLAB_HOST:-}"
    if [[ -z "$host" ]]; then
        echo "ERROR: GITLAB_HOST is not set." >&2
        echo "  Add 'export GITLAB_HOST=your-gitlab-host' to .env" >&2
        exit 1
    fi

    # --status: show token coverage without making any changes
    if [[ "${1:-}" == "--status" ]]; then
        echo "[ ws gitlab-auth --status: $host ]"
        echo ""
        echo "Configured token slots (from defaults.gitTokens in ecosystem config):"
        local found=0
        while IFS= read -r key; do
            [[ -z "$key" || "$key" == "null" ]] && continue
            [[ "$key" != "$host/"* ]] && continue
            local var
            var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$auth_eco")
            [[ -z "$var" || "$var" == "null" ]] && continue
            found=1
            if ! ws_require_provider_token_var "$var"; then
                echo "  ✗ $var (invalid token var name) — covers $key" >&2
                continue
            fi
            local val="${!var:-}"
            if [[ -n "$val" ]]; then
                echo "  ✓ $var (set) — covers $key"
            else
                echo "  ✗ $var (NOT SET) — covers $key"
                echo "    → Add 'export $var=<token>' to .env, then re-run: ws gitlab-auth"
            fi
        done < <(yq '.defaults.gitTokens | keys | .[]' "$auth_eco" 2>/dev/null)
        if [[ "$found" -eq 0 ]]; then
            echo "  (none — add entries to defaults.gitTokens in ecosystem.local.yaml)"
        fi
        echo ""
        echo "Tip: run 'ws diagnose <comp>' to see which token covers a specific component."
        return 0
    fi

    # Use the configured fork-home namespace to identify the write
    # (Developer) token. `identity.forkRemote` is only a local git remote
    # alias; it is not a trust or token-selection boundary.
    local write_token_var="" write_key=""
    local fork_namespace fork_token_target
    fork_namespace=$(yq '.identity.homes.fork.namespace // ""' "$eco")
    [[ "$fork_namespace" == "null" ]] && fork_namespace=""
    if [[ -z "$fork_namespace" ]]; then
        echo "ERROR: identity.homes.fork.namespace is not set in ecosystem config." >&2
        echo "  Add 'identity.homes.fork.namespace: <host>/<group-path>' to ecosystem.local.yaml." >&2
        exit 1
    fi

    fork_token_target=$(printf '%s' "$fork_namespace" \
        | sed 's|^ssh://[^@]*@\([^:/]*\)[^/]*/|\1/|; s|^https://[^/@]*@||; s|^http://[^/@]*@||; s|^https://||; s|^http://||; s|^git@\([^:]*\):|\1/|; s|\.git$||; s|/$||')
    fork_token_target="${fork_token_target#/}"
    if [[ "$fork_token_target" != "$host" && "$fork_token_target" != "$host/"* ]]; then
        fork_token_target="$host/$fork_token_target"
    fi
    while IFS= read -r key; do
        [[ -z "$key" || "$key" == "null" ]] && continue
        [[ "$key" != "$host/"* ]] && continue
        if [[ ( "$fork_token_target" == "$key" || "$fork_token_target" == "$key/"* ) && ${#key} -gt ${#write_key} ]]; then
            write_key="$key"
            write_token_var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$auth_eco")
        fi
    done < <(yq '.defaults.gitTokens | keys | .[]' "$auth_eco" 2>/dev/null)

    if [[ -z "$write_token_var" || "$write_token_var" == "null" ]]; then
        echo "ERROR: No gitTokens entry found for fork namespace '$fork_namespace' on host '$host'." >&2
        echo "  Expected a key covering: ${fork_token_target:-$fork_namespace}" >&2
        echo "  Add it to defaults.gitTokens in ecosystem.local.yaml." >&2
        exit 1
    fi
    ws_require_provider_token_var "$write_token_var" || exit 1

    local write_token="${!write_token_var:-}"
    if [[ -z "$write_token" ]]; then
        echo "ERROR: Token env var '$write_token_var' is not set in environment." >&2
        echo "  Add it to .env (see docs/git-provider-setup.md)." >&2
        exit 1
    fi

    echo "[ ws gitlab-auth: $host ]"
    echo ""

    # 1. Register write token with glab
    echo "1. Registering write token ($write_token_var) with glab..."
    if printf '%s\n' "$write_token" | glab auth login --hostname "$host" --stdin 2>/dev/null; then
        echo "   ✓ glab authenticated"
    else
        echo "   ✗ glab auth login failed" >&2
        exit 1
    fi

    # 2. Store configured host tokens path-scoped in git credential helper.
    # Path scoping lets a split source-read / fork-write setup keep both
    # credentials available without one host-wide credential shadowing the other.
    echo "2. Storing path-scoped credentials in git credential helper..."
    git config --global "credential.https://$host.useHttpPath" true
    local stored_count=0
    approve_git_credential() {
        local cred_path="$1"
        local token_val="$2"
        git credential approve <<EOF
protocol=https
host=$host
path=$cred_path
username=oauth2
password=$token_val
EOF
        stored_count=$((stored_count + 1))
    }
    while IFS= read -r key; do
        [[ -z "$key" || "$key" == "null" ]] && continue
        [[ "$key" != "$host/"* ]] && continue
        local token_var token_val cred_path normalized_path git_path
        token_var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$auth_eco")
        [[ -z "$token_var" || "$token_var" == "null" ]] && continue
        ws_require_provider_token_var "$token_var" || exit 1
        token_val="${!token_var:-}"
        [[ -z "$token_val" ]] && continue
        cred_path="${key#"$host/"}"
        [[ -z "$cred_path" ]] && continue
        normalized_path="${cred_path%.git}"
        approve_git_credential "$normalized_path" "$token_val"
        git_path="$normalized_path.git"
        if [[ "$git_path" != "$normalized_path" ]]; then
            approve_git_credential "$git_path" "$token_val"
        fi
    done < <(yq '.defaults.gitTokens | keys | .[]' "$auth_eco" 2>/dev/null)
    echo "   ✓ Stored path-scoped credentials in $(git config --global credential.helper || echo 'credential store') for $host ($stored_count entries)"

    # 3. Verify with git ls-remote on a declared component URL
    echo "3. Verifying git access..."
    local test_url=""
    while IFS= read -r comp_url; do
        [[ -z "$comp_url" || "$comp_url" == "null" ]] && continue
        [[ "$comp_url" == "https://$host/"* ]] && test_url="$comp_url" && break
    done < <(yq '.components[].repo // ""' "$eco" 2>/dev/null)

    if [[ -n "$test_url" ]]; then
        GIT_AUTH_ENV=()
        git_auth_env_for_url "$test_url"
        if git_auth_run git ls-remote "$test_url" HEAD &>/dev/null; then
            if [[ -n "${GIT_AUTH_LABEL:-}" ]]; then
                echo "   ✓ git access verified using $GIT_AUTH_LABEL ($test_url)"
            else
                echo "   ✓ git access verified ($test_url)"
            fi
        else
            echo "   ✗ git ls-remote failed: $test_url" >&2
            echo "   Token may lack read access to this repo." >&2
            exit 1
        fi
    else
        echo "   (skipped — no component URLs in ecosystem config to test against)"
    fi

    # 4. Report other configured tokens
    local other_count=0
    while IFS= read -r key; do
        [[ -z "$key" || "$key" == "null" || "$key" == "$write_key" ]] && continue
        [[ "$key" != "$host/"* ]] && continue
        local other_var
        other_var=$(KEY="$key" yq '.defaults.gitTokens[strenv(KEY)] // ""' "$auth_eco")
        [[ -z "$other_var" || "$other_var" == "null" ]] && continue
        ws_require_provider_token_var "$other_var" || exit 1
        local other_val="${!other_var:-}"
        if [[ -n "$other_val" ]]; then
            echo "   ✓ Additional token $other_var available for $key"
        else
            echo "   ✗ Additional token $other_var (for $key) is not set in environment" >&2
        fi
        other_count=$((other_count + 1))
    done < <(yq '.defaults.gitTokens | keys | .[]' "$auth_eco" 2>/dev/null)

    echo ""
    echo "Done. Run 'ws clone <component>' to continue."
}

COMMAND="${1:-help}"
shift 2>/dev/null || true

# Allow `ws help <subcommand> [args]` as an alias for `ws <subcommand>
# --help [args]`. New sessions reach for either form depending on
# habit; both should reach per-subcommand help. This rewrite happens
# before the dispatch case so the subcommand handler does the actual
# help work — keeps each subcommand the source of truth for its own
# help text.
if [[ ( "$COMMAND" == "help" || "$COMMAND" == "--help" || "$COMMAND" == "-h" ) && $# -gt 0 ]]; then
    COMMAND="$1"
    shift
    set -- "--help" "$@"
fi

# Detect a help variant in the remaining args so the post-dispatch
# footer can suppress for per-subcommand help (e.g. `ws hoard --help`)
# the same way it suppresses for the top-level help command.
_WS_IS_HELP=0
for _arg in "$@"; do
    case "$_arg" in --help|-h|help) _WS_IS_HELP=1; break ;; esac
done

# One-line stderr nudge appended after every successful subcommand
# dispatch — keeps the `ws orient` meta-rule discoverable for both
# humans and agents who entered mid-session without reading
# AGENTS.md. Stderr so it never contaminates captured stdout (e.g.
# `var=$(ws log --oneline)`). Suppressed for orient itself (no
# recursive recommendation), for help variants (the user is reading,
# not doing), and via the WS_FOOTER_DISABLE env var (agents and
# scripts that want quiet output). With `set -e` enabled at the top
# of this file, the footer naturally doesn't fire on error paths —
# the script exits before reaching the call.
_ws_footer() {
    # Explicit opt-out for agents and scripts that want quiet
    # stderr from every ws subcommand.
    [[ -n "${WS_FOOTER_DISABLE:-}" ]] && return 0
    # Auto-skip in bats test runs so output-shape assertions across
    # the bats suite don't pick up the stderr footer as noise. The
    # footer's purpose is human/agent discoverability mid-session;
    # automated tests are neither. Footer-focused tests opt back in
    # by clearing `BATS_TEST_NAME` for the child process via
    # `env -u BATS_TEST_NAME ...`.
    [[ -n "${BATS_TEST_NAME:-}" ]] && return 0
    case "$COMMAND" in
        orient|help|--help|-h) return 0 ;;
    esac
    [[ "$_WS_IS_HELP" -eq 1 ]] && return 0
    # Use dim ANSI only when stderr is a terminal — captured logs and
    # CI output should see plain text instead of raw `\e[2m...\e[0m`
    # escape sequences. The visible text stays identical in both
    # branches so search/grep on the message works the same way
    # regardless of styling.
    if [[ -t 2 ]]; then
        printf $'\e[2m↪ switching tasks? `ws orient` lists available tools.\e[0m\n' >&2
    else
        printf '↪ switching tasks? `ws orient` lists available tools.\n' >&2
    fi
    # Command-specific next-step nudge. After a push the review phase is
    # next: steer toward `ws review` over raw gh/glab (or the ws gh / ws
    # glab escape hatches), which is easy to reach for now that tokens are
    # injected but loses thread-resolution / since-filtering / attribution.
    case "$COMMAND" in
        push)
            local _rev='↪ review phase: use `ws review <comp> [cr#]` to read/triage CR feedback — prefer it over raw gh/glab or `ws gh`/`ws glab` unless truly needed.'
            if [[ -t 2 ]]; then
                printf '\e[2m%s\e[0m\n' "$_rev" >&2
            else
                printf '%s\n' "$_rev" >&2
            fi
            ;;
    esac
}

case "$COMMAND" in
    help|--help|-h)
        ws_help
        ;;
    list)
        bash "$SCRIPT_DIR/ws-list.sh" "$@"
        ;;
    orient)
        bash "$SCRIPT_DIR/ws-orient.sh" "$@"
        ;;
    status)
        bash "$SCRIPT_DIR/ws-status.sh" "$@"
        ;;
    clone)
        bash "$SCRIPT_DIR/ws-clone.sh" "$@"
        ;;
    clone-fork)
        bash "$SCRIPT_DIR/ws-clone-fork.sh" "$@"
        ;;
    pull)
        bash "$SCRIPT_DIR/ws-pull.sh" "$@"
        ;;
    vscode)
        bash "$SCRIPT_DIR/ws-vscode.sh" "$@"
        ;;
    push)
        ws_push "$@"
        ;;
    cr)
        ws_cr "$@"
        ;;
    issue)
        ws_issue "$@"
        ;;
    test)
        bash "$SCRIPT_DIR/ws-test.sh" "$@"
        ;;
    lint)
        bash "$SCRIPT_DIR/ws-lint.sh" "$@"
        ;;
    review)
        bash "$SCRIPT_DIR/ws-review.sh" "$@"
        ;;
    commit)
        bash "$SCRIPT_DIR/ws-commit.sh" "$@"
        ;;
    checkout)
        ws_checkout "$@"
        ;;
    log)
        ws_log "$@"
        ;;
    clean)
        ws_clean "$@"
        ;;
    exec)
        ws_exec "$@"
        ;;
    realm)
        bash "$SCRIPT_DIR/ws-realm.sh" "$@"
        ;;
    hoard)
        bash "$SCRIPT_DIR/ws-hoard.sh" "$@"
        ;;
    component)
        bash "$SCRIPT_DIR/ws-component.sh" "$@"
        ;;
    gitlab-auth)
        ws_gitlab_auth "$@"
        ;;
    gh)
        bash "$SCRIPT_DIR/ws-gh.sh" "$@"
        ;;
    glab)
        bash "$SCRIPT_DIR/ws-glab.sh" "$@"
        ;;
    diagnose)
        ws_diagnose "$@"
        ;;
    preflight)
        bash "$SCRIPT_DIR/ws-preflight.sh" "$@"
        ;;
    audit-permissions)
        bash "$SCRIPT_DIR/ws-audit-permissions.sh" "$@"
        ;;
    actions)
        bash "$SCRIPT_DIR/ws-realm.sh" actions "$@"
        ;;
    mcp-setup)
        bash "$SCRIPT_DIR/ws-mcp-setup.sh" "$@"
        ;;
    mcp-status)
        bash "$SCRIPT_DIR/ws-mcp-setup.sh" --status
        ;;
    hook-bypass)
        bash "$SCRIPT_DIR/ws-hook-bypass.sh" "$@"
        ;;
    session)
        bash "$SCRIPT_DIR/ws-session-config.sh" "$@"
        ;;
    k8s)
        bash "$SCRIPT_DIR/ws-k8s.sh" "$@"
        ;;
    docker)
        bash "$SCRIPT_DIR/ws-docker.sh" "$@"
        ;;
    whoami)
        bash "$SCRIPT_DIR/ws-whoami.sh" "$@"
        ;;
    *)
        echo "ERROR: Unknown command '$COMMAND'. Run 'ws help' for usage." >&2
        exit 1
        ;;
esac

_ws_footer
