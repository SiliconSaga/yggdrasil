{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [],
    "allow": [
      "Bash(bash scripts/ws help:*)",
      "Bash(bash scripts/ws list)",
      "Bash(bash scripts/ws status:*)",
      "Bash(bash scripts/ws clone *)",
      "Bash(bash scripts/ws pull:*)",
      "Bash(bash scripts/ws vscode)",
      "Bash(bash scripts/ws diagnose:*)",
      "Bash(bash scripts/ws actions:*)",
      "Bash(bash scripts/ws orient)",
      "Bash(bash scripts/ws audit-permissions)",
      "Bash(bash scripts/ws realm list)",
      "Bash(bash scripts/ws realm init)",
      "Bash(bash scripts/ws hoard)",
      "Bash(bash scripts/ws hoard --help)",
      "Bash(bash scripts/ws hoard -h)",
      "Bash(bash scripts/ws hoard list)",
      "Bash(bash scripts/ws hoard init:*)",
      "Bash(bash scripts/ws hoard cadence)",
      "Bash(bash scripts/ws hoard thalamus-path)",
      "Bash(bash scripts/ws preflight)",
      "Bash(bash scripts/ws preflight --soft)",
      "Bash(bash scripts/ws component)",
      "Bash(bash scripts/ws component --help)",
      "Bash(bash scripts/ws component -h)",
      "Bash(bash scripts/ws component list)",
      "Bash(bash scripts/ws component init:*)",
      "Bash(bash tests/vendor/bats-core/bin/bats tests/*)",
      "Bash(bash tests/vendor/bats-core/bin/bats tests/* tests/*)",
      "Bash(ws help:*)",
      "Bash(ws list)",
      "Bash(ws status:*)",
      "Bash(ws clone *)",
      "Bash(ws pull:*)",
      "Bash(ws vscode)",
      "Bash(ws diagnose:*)",
      "Bash(ws actions:*)",
      "Bash(ws orient)",
      "Bash(ws audit-permissions)",
      "Bash(ws hoard cadence)",
      "Bash(ws hoard thalamus-path)",
      "Bash(ws preflight)",
      "Bash(ws preflight --soft)",
      "Bash(ws realm list)",
      "Bash(ws realm init)",
      "Bash(ws hoard)",
      "Bash(ws hoard --help)",
      "Bash(ws hoard -h)",
      "Bash(ws hoard list)",
      "Bash(ws hoard init:*)",
      "Bash(ws component)",
      "Bash(ws component --help)",
      "Bash(ws component -h)",
      "Bash(ws component list)",
      "Bash(ws component init:*)",
      "Bash(ws session:*)",
      "Bash(bash scripts/ws session:*)",
      "Bash(ws test:*)",
      "Bash(bash scripts/ws test:*)",
      "Bash(ws lint:*)",
      "Bash(bash scripts/ws lint:*)",
      "Bash(ws build:*)",
      "Bash(bash scripts/ws build:*)",
      "Bash(ws review:*)",
      "Bash(bash scripts/ws review:*)",
      "Bash(ws log:*)",
      "Bash(bash scripts/ws log:*)",
      "Bash(ws commit:*)",
      "Bash(bash scripts/ws commit:*)",
      "Bash(ws whoami:*)",
      "Bash(bash scripts/ws whoami:*)",
      "Bash(ws clean)",
      "Bash(bash scripts/ws clean)",
      "Bash(bash scripts/ws mcp-setup --dry-run)",
      "Bash(bash scripts/ws mcp-status)",
      "Bash(ws mcp-setup --dry-run)",
      "Bash(ws mcp-status)",
      "Bash(ws hook-bypass --help)",
      "Bash(ws hook-bypass -h)",
      "Bash(bash scripts/ws hook-bypass --help)",
      "Bash(bash scripts/ws hook-bypass -h)",
      "Bash(ws help hook-bypass)",
      "Bash(bash scripts/ws help hook-bypass)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gdd-permission-hook.sh\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gdd-permission-hook.sh\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gdd-permission-hook.sh\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gdd-permission-hook.sh\""
          }
        ]
      }
    ]
  }
}
