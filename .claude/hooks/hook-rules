# GDD hook rules — committed baseline.
#
# Read by .claude/hooks/gdd-permission-hook.sh. Per-machine overrides
# go in hook-rules.local (copy hook-rules.local.example). Format: flat
# sectioned text — [section] headers, one entry per line, '#' comments,
# blank lines ignored.

[scratch-dirs]
# Edit/Write tool calls under these workspace-relative paths auto-allow.
# Mirror the "Workspace-local scratch" section of .gitignore.
.tmp/
.commits/
.crs/
.issues/
.outputs/

[ask-commands]
# Glob patterns. A match makes the hook emit permissionDecision: "ask" —
# a forced permission prompt in any mode, NOT a block. The agent still
# runs the command once the human approves. Patterns match the full
# command string; '*' matches any substring. NOTE: ask patterns are
# matched against the NORMALIZED command (bash scripts/ws → ws), so a
# pattern only needs the bare `ws ...` form — a `bash scripts/ws ...`
# pattern can never match the normalized command and would be dead.
rm -rf*
rm -fr*
rm -r *
git*reset --hard*
git*clean -f*
git*clean -d*
find * -delete*
find*-exec*
find*-execdir*
find*-fprint*
find*-fls*
find*-ok*
ws exec *
ws hook-bypass [a-z]*
# Interpreter passthroughs. Quoted spans (single-quoted, and
# double-quoted with no live `$`/backtick) are masked before Tier-1
# classification — they are literal data to bash — so a
# `bash -c '…payload…'` no longer trips the composition/pipe/redirect
# denies on operators INSIDE the quotes — the payload is deliberately
# opaque to the hook. A token-aware check in the hook runs after Tier
# 1 and before later allow logic, recognizes quoted or unquoted
# sh-family interpreter basenames behind assignments / env / command /
# exec wrappers, covers intervening options plus combined short flags
# such as `bash -lc`, and fails closed on env split-string or unknown
# env option shapes.
# This simple glob remains a readable defense-in-depth policy for the
# common spelling (it also sweeps in `ssh -c <cipher>` — a rare shape
# here, and an ask, not a block).
*sh -c *
# Adding an arbitrary URL to ecosystem.local.yaml is the component adoption trust gate. The ordinary clone remains automatic; either supported spelling requires a human.
ws clone *--add-to-ecosystem*
ws clone *--add-eco*
ws clone-fork *--add-to-ecosystem*
ws clone-fork *--add-eco*
# Writing agent tool endpoints changes the workspace trust surface. Preview and
# status forms remain allowlisted; the bare mutating form requires a human.
ws mcp-setup
# ws review reads are allowlisted via Bash(ws review:*); the outward-
# facing forms stay human-gated here (ask runs before the allow tier):
# reply posts a comment to the PR, --resolve / --resolve-all mutate
# review-thread state.
ws review * reply *
ws review * threads * --resolve*
# Activating a realm grants trust to its config surface (adapters, MCP
# endpoints, component catalog). --trust exists so a HUMAN can skip the
# interactive confirm — an agent passing it must still land on a person.
ws realm use *

[redirect-commands]
# Raw commands with a ws equivalent. The hook denies a match in Tier 2
# (between composition deny and ask) with the suggestion text below.
# Format: <slug> | <pattern> | <suggestion>. Slug is kebab-case (^[a-z][a-z0-9-]*$);
# it doubles as the bypass-marker filename and the ws hook-bypass argument.
# Pattern is a bash glob. Suggestion is free text, ends the line, may contain
# pipes (parsing splits on the first two " | " only).
git-commit   | git commit*    | Use `ws commit <comp> <bodyfile>` — handles Co-Authored-By trailer + bodyfile-driven staging. See `ws help commit`. If `ws commit` doesn't fit (rare), run `ws hook-bypass git-commit` to request a session-scoped bypass.
git-push     | git push*      | Use `ws push <comp> [branch]` — handles fork-remote selection from identity.forkRemote and sets upstream on first push. `ws hook-bypass git-push` for a session-scoped bypass.
gh-pr-create | gh pr create*  | Use `ws cr <comp> <title> <bodyfile>` — bodyfile-driven, applies identity substitutions, picks the right token + remote. `ws hook-bypass gh-pr-create` for a session-scoped bypass.
# The same three verbs wrapped in `ws exec`. Without these, `ws exec <comp> git
# commit …` reached an ASK where the raw form is DENIED — a softer path around
# the redirect, ending in a rubber-stamped prompt and a commit with no
# Co-Authored-By trailer. `ws exec` is for commands with no wrapper; where a
# wrapper exists it is not a way to reach past it.
git-commit-exec | ws exec * git commit* | Use `ws commit <comp> <bodyfile>` — wrapping it in `ws exec` skips the Co-Authored-By trailer and the bodyfile staging, which is the whole point of the wrapper. `ws hook-bypass git-commit-exec` for a session-scoped bypass.
git-push-exec   | ws exec * git push*   | Use `ws push <comp> [branch]` — wrapping it in `ws exec` skips fork-remote selection and upstream setup. `ws hook-bypass git-push-exec` for a session-scoped bypass.
gh-pr-create-exec | ws exec * gh pr create* | Use `ws cr <comp> <title> <bodyfile>` — wrapping it in `ws exec` skips the identity substitutions and token/remote selection. `ws hook-bypass gh-pr-create-exec` for a session-scoped bypass.
git-mv       | git mv*        | Don't `git mv` — it pre-stages the rename and breaks `ws commit`'s bodyfile staging. Instead `mv <src> <dst>` (plain), then list BOTH the old and new paths under `add:` in your `ws commit` bodyfile; git still records a clean rename. `ws hook-bypass git-mv` for a session-scoped bypass.
gh-repo-fork | *gh repo fork* | Use `ws clone-fork <component>` — creates the fork AND clones it AND wires fork+source remotes with a synced main, none of which `gh repo fork` does for you. Component not declared yet? `ws clone-fork --url <source-url> --add-to-ecosystem` does the declaration too. `ws hook-bypass gh-repo-fork` for a session-scoped bypass.
# gh subcommands that MUTATE THE WORKING TREE THEY STAND IN. `ws gh` takes no
# target and runs at the workspace root, so `ws gh pr checkout` rewrites the
# WORKSPACE's tree — it has silently replaced yggdrasil's scripts/ and
# templates/ with a Terasology PR before. Anchored patterns (not *gh …*) so
# the recommended `ws exec <comp> gh …` form cannot match its own redirect.
gh-checkout      | ws gh pr checkout* | `ws gh` runs at the workspace ROOT — `gh pr checkout` here rewrites the workspace's working tree, not the repo you meant. Run it inside the target instead: `ws exec <comp> gh pr checkout <n>` (use component `yggdrasil` if the workspace repo itself is intended). `ws hook-bypass gh-checkout` for a session-scoped bypass.
gh-checkout-raw  | gh pr checkout*    | `gh pr checkout` mutates whatever repo it stands in — from the workspace root that is the workspace itself. Run it inside the target: `ws exec <comp> gh pr checkout <n>` (component `yggdrasil` if the workspace repo is intended). `ws hook-bypass gh-checkout-raw` for a session-scoped bypass.
gh-repo-sync     | ws gh repo sync*   | `ws gh` runs at the workspace ROOT — `gh repo sync` here syncs the workspace repo, not the component you meant. Use `ws pull <comp>`, or `ws exec <comp> gh repo sync …`. `ws hook-bypass gh-repo-sync` for a session-scoped bypass.
gh-repo-sync-raw | gh repo sync*      | `gh repo sync` mutates the repo it stands in. Use `ws pull <comp>`, or `ws exec <comp> gh repo sync …`. `ws hook-bypass gh-repo-sync-raw` for a session-scoped bypass.
# Review READING has a wrapper; reaching past it costs the thread ids, the
# resolved/unresolved state and `--since <ref>` filtering, and then a reply has
# nothing to resolve against. Scoped to the comment-fetching forms only: a plain
# `pr view` status check is deliberately left alone (see the non-mutating-ws-gh
# test), and anything ws review genuinely cannot do — checks, diffs, arbitrary
# API — must stay reachable, because denying with no alternative is worse than
# the reflex. When one of these bypasses gets requested, treat it as a feature
# request for `ws review` rather than a nuisance: that is the gap showing itself.
# Two are already known, and are why these patterns stay narrow — widening them
# before the gaps close would only manufacture bypass requests:
#   - No machine-readable output. `gh pr view --json reviewDecision,reviews --jq …`
#     is a real fallback, not a reflex; `ws review` prints for humans only.
#   - Needs a local clone. `ws review <comp> <cr#>` fails with "is not cloned
#     locally", while `gh --repo owner/name` reads a PR without one — a clone the
#     read does not actually require.
gh-pr-comments   | *gh pr view*--comments*        | Use `ws review <comp> <cr#>` — it carries thread ids, resolved state and `--since <ref>` filtering that `gh pr view --comments` cannot, and `ws review reply` needs those ids. `ws hook-bypass gh-pr-comments` for a session-scoped bypass; if you needed it because `ws review` lacks something, say so — that is worth adding.
gh-pr-comments-api | *gh api *pulls/*/comments*   | Use `ws review <comp> <cr#>` — the raw endpoint returns comments with no thread grouping or resolution state, which is most of what makes review triage tractable. `ws hook-bypass gh-pr-comments-api` for a session-scoped bypass.
gh-pr-reviews-api  | *gh api *pulls/*/reviews*    | Use `ws review <comp> <cr#>` — it renders reviews alongside their inline comments and threads. `ws hook-bypass gh-pr-reviews-api` for a session-scoped bypass.
glab-mr-note       | *glab mr note*               | Use `ws review <comp> reply <cr#> <thread-id> <msg> [--resolve]` — replying through the raw note API leaves the thread unresolved and unattributed. `ws hook-bypass glab-mr-note` for a session-scoped bypass.
gh-cli       | gh *           | Use `ws gh <args>` — injects the workspace GH_TOKEN from .env so the command authenticates without interactive `gh auth login`. Any `gh` subcommand passes through. `ws hook-bypass gh-cli` for a session-scoped bypass.
glab-cli     | glab *         | Use `ws glab <args>` — injects the workspace GitLab token from .env so the command authenticates without interactive login. Any `glab` subcommand passes through. `ws hook-bypass glab-cli` for a session-scoped bypass.

[adapter-redirect-commands]
# Tier 3 — raw test/lint/build runners with a ws equivalent. The hook
# resolves the component from $cwd (must be under components/<comp>/)
# and the active realm, then checks the realm's adapter file at
# realms/<realm>/adapters/<comp>.yaml:
#
#   adapter has commands.<verb> wired → deny with ws <verb> <comp> pointer
#                                       (matching the [redirect-commands] tier)
#   adapter missing or no commands.<verb> → emit a stderr nudge, fall through
#                                            to normal allow/ask evaluation
#   $cwd outside any component → rule doesn't fire (raw runner at workspace
#                                root is a legitimate workspace-test invocation)
#
# Format: <slug> | <pattern> | <verb>. Verb is one of test/lint/build —
# the ws subcommand the raw command maps to AND the key under `commands.`
# in the adapter file. Slug is kebab-case; doubles as the bypass-marker
# filename and the ws hook-bypass argument.
pytest      | pytest*            | test
pytest-mod  | python* -m pytest* | test
gradle-test | gradle test*       | test
ruff        | ruff*              | lint
black       | black*             | lint
mypy        | mypy*              | lint

[scoped-redirect-commands]
# Raw tools redirected only when a session-key is set in the session file.
# Format: <slug> | <pattern> | <session-key> | <suggestion>.
# Note: `ws k8s` is intentionally NOT in settings.json permissions.allow. The
# hook auto-allows `ws k8s` for kubectl read-only operations ONLY when a guard
# scope is set (GDD_K8S_CONTEXT) — writes still prompt, out-of-scope is denied.
# See the scoped-redirect (Tier 2b) handling in gdd-permission-hook.sh.
k8s | kubectl* | GDD_K8S_CONTEXT | Use `ws k8s <args>` — a guard scope is active; raw kubectl bypasses the namespace guard. `ws hook-bypass k8s` to lift for this session.
