# Copy to .env (gitignored) and fill in real values.
# Load with: source .env  (or add to shell profile)
# gh reads GH_TOKEN automatically — no 'gh auth login' step needed.

export GH_TOKEN=github_pat_xxxxxxxxxxxx

# GitHub username associated with GH_TOKEN.
# Optional if token has Account (read) permission — the script can auto-detect.
# Required for fine-grained PATs without that permission.
export GH_USER=your-github-username
