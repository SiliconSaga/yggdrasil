# Copy to .env (gitignored) and fill in real values.
# Load with: source .env  (or add to shell profile)
# Only uncomment the sections for providers you use.

# ── GitHub ───────────────────────────────────────────────────
# Create a classic personal access token at:
#   https://github.com/settings/tokens/new
#
# Required scopes:
#   repo           (full repo access — PRs, issues, code, cross-org forks)
#   workflow        (if you need to touch .github/workflows files)
#
# Note: Fine-grained PATs exist but have known limitations with cross-org
# PRs and workflow files. Classic PATs are recommended for GDD workspaces.
#
# The gh CLI reads GH_TOKEN automatically — no 'gh auth login' needed.
export GH_TOKEN=ghp_xxxxxxxxxxxx
export GH_USER=your-github-username

# ── Commit attribution ───────────────────────────────────────
# Model name used in the ws commit Co-Authored-By trailer (ws-commit.sh).
# The :- form supplies a default but still lets an inline override pass
# through, e.g. CLAUDE_MODEL="Sonnet 4.6" ws commit … for a sub-agent.
export CLAUDE_MODEL="${CLAUDE_MODEL:-Opus 4.8}"

# ── GitLab ───────────────────────────────────────────────────
# Self-hosted / paid tiers: prefer a Group Access Token over a Personal Access Token.
#   Group token: <host>/<group>/-/settings/access_tokens
# gitlab.com free tier: Group Access Tokens are not available. Use a Personal
#   Access Token with api scope instead. You can still use the multi-token env
#   var pattern below — just point multiple vars at the same PAT to exercise
#   the routing logic while staying within free-tier constraints.
#   Personal token: https://gitlab.com/-/user_settings/personal_access_tokens
#
# For self-hosted instances, set GITLAB_HOST and register the host with glab once:
#   source .env && glab auth login --hostname "$GITLAB_HOST" --token "${GITLAB_GDD_GROUP_WRITE_TOKEN:-$GITLAB_TOKEN}"
#
# ── Single-group setup (simple) ──────────────────────────────
# export GITLAB_TOKEN=glpat-xxxxxxxxxxxx        # Group token, Developer role, api scope
# export GITLAB_USER=your-gitlab-username
# export GITLAB_HOST=gitlab.example.com         # self-hosted only
#
# ── Multi-group setup (fork → upstream) ──────────────────────
# Fork group token (Developer role) — git clone/push + MR creation in fork group
# export GITLAB_GDD_GROUP_WRITE_TOKEN=glpat-xxxxxxxxxxxx
#
# Upstream group token (Reporter role) — MR creation and issue filing on upstream
# Rename/duplicate this when you have multiple upstream targets.
# export GITLAB_GDD_GROUP_REPORTER_TOKEN=glpat-xxxxxxxxxxxx
#
# Common:
# export GITLAB_USER=your-gitlab-username
# export GITLAB_HOST=gitlab.example.com         # self-hosted only
#
# After sourcing, store the write token for HTTPS git operations (run once):
#   git credential approve <<EOF
#   protocol=https
#   host=$GITLAB_HOST
#   username=oauth2
#   password=$GITLAB_GDD_GROUP_WRITE_TOKEN
#   EOF
