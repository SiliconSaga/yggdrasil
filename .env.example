# Copy to .env (gitignored) and fill in real values.
# Load with: source .env  (or add to shell profile)
# Only uncomment the sections for providers you use.

# ── GitHub ───────────────────────────────────────────────────
# Create a classic personal access token (scopes pre-selected) at:
#   https://github.com/settings/tokens/new?scopes=repo,read:org,read:discussion,read:project&description=GDD%20agent%20write%20token
#
# Scopes:
#   repo                                      (push, PRs, issues, code, cross-org forks)
#   read:org, read:discussion, read:project   (baseline — lets 'gh pr edit'-shaped ops work)
#   workflow                                  (only if you touch .github/workflows files)
#
# A classic PAT is the simple path this base setup targets:
#   + one token; works across every org/fork your account can access
#   + no per-repo wiring to maintain
#   − account-wide (it can reach everything your account can) and you renew it by hand at expiry
# For least-privilege (fine-grained PATs) or a shared, team-managed bot
# identity (a separate machine account), see docs/git-provider-setup.md.
#
# The gh CLI reads GH_TOKEN automatically — no 'gh auth login' needed.
export GH_TOKEN=ghp_xxxxxxxxxxxx

# ── Commit attribution ───────────────────────────────────────
# Commit identity is per-session, not configured here: an agent establishes
# it at 'ws orient' (written to .tmp/gdd-agent-sessions/<session-id>.env);
# 'ws whoami' shows it. A human committing manually passes 'ws commit --human'
# (no Co-Authored-By trailer). The environment is never consulted for identity.
# See docs/plans/2026-06-15-multi-agent-attribution-design.md.

# ── GitLab ───────────────────────────────────────────────────
# Self-hosted / paid tiers: prefer a Group Access Token over a Personal Access Token.
#   Group token: <host>/<group>/-/settings/access_tokens
# gitlab.com free tier: Group Access Tokens are not available. Use a Personal
#   Access Token with api scope instead. You can still use the multi-token env
#   var pattern below — just point multiple vars at the same PAT to exercise
#   the routing logic while staying within free-tier constraints.
#   Personal token: https://gitlab.com/-/user_settings/personal_access_tokens
#
# For self-hosted instances, set GITLAB_HOST and register the host with glab once:
#   source .env && glab auth login --hostname "$GITLAB_HOST" --token "${GITLAB_GDD_GROUP_WRITE_TOKEN:-$GITLAB_TOKEN}"
#
# ── Single-group setup (simple) ──────────────────────────────
# export GITLAB_TOKEN=glpat-xxxxxxxxxxxx        # Group token, Developer role, api scope
# export GITLAB_USER=your-gitlab-username
# export GITLAB_HOST=gitlab.example.com         # self-hosted only
#
# ── Multi-group setup (fork → source project) ────────────────
# Fork group token — Maintainer if it must create forks; Developer is enough for existing fork push/MR work.
# export GITLAB_GDD_GROUP_WRITE_TOKEN=glpat-xxxxxxxxxxxx
#
# Source group token (Reporter role) — review and issue operations on the source project
# Rename/duplicate this when you have multiple source-project targets.
# export GITLAB_GDD_GROUP_REPORTER_TOKEN=glpat-xxxxxxxxxxxx
#
# Common:
# export GITLAB_USER=your-gitlab-username
# export GITLAB_HOST=gitlab.example.com         # self-hosted only
#
# ws push and ws clone-fork inject matching .env tokens for their own HTTPS Git operations.
# Optional: store the write token for raw git or IDE background fetches that use HTTPS remotes:
#   git credential approve <<EOF
#   protocol=https
#   host=$GITLAB_HOST
#   username=oauth2
#   password=$GITLAB_GDD_GROUP_WRITE_TOKEN
#   EOF
